@using Vfps.Data.Models

@*
    Everything worth knowing about a single namespace, as a compact label/value list.

    Rows whose value is empty (prefix, suffix, validation regex) are left out entirely rather
    than rendered as blanks. A definition list in a two-column grid (detail-list, wwwroot/app.css)
    keeps each value beside its label - spread to opposite edges of the panel, the two were a
    long way apart to read across.
*@

<div class="bb:space-y-3">
    <div>
        <p class="bb:text-sm bb:font-semibold">@Namespace.Name</p>
        @if (!string.IsNullOrWhiteSpace(Namespace.Description))
        {
            <p class="bb:text-sm bb:text-muted-foreground">@Namespace.Description</p>
        }
    </div>

    <dl class="detail-list bb:text-sm">
        <dt>@Localizer["App.Namespaces.CreatedAt"]</dt>
        <dd>@FormatTimestamp(Namespace.CreatedAt)</dd>

        <dt>@Localizer["App.Namespaces.LastUpdated"]</dt>
        <dd>@FormatTimestamp(Namespace.LastUpdatedAt)</dd>

        <dt>@Localizer["App.Namespaces.GenerationMethodColumn"]</dt>
        <dd>@PseudonymGenerationMethodDisplay.FriendlyName(Namespace.PseudonymGenerationMethod)</dd>

        <dt>@Localizer["App.Namespaces.LengthColumn"]</dt>
        <dd>@Namespace.PseudonymLength</dd>

        @if (!string.IsNullOrEmpty(Namespace.PseudonymPrefix))
        {
            <dt>@Localizer["App.Namespaces.Prefix"]</dt>
            <dd class="bb:font-mono">@Namespace.PseudonymPrefix</dd>
        }
        @if (!string.IsNullOrEmpty(Namespace.PseudonymSuffix))
        {
            <dt>@Localizer["App.Namespaces.Suffix"]</dt>
            <dd class="bb:font-mono">@Namespace.PseudonymSuffix</dd>
        }
        @if (!string.IsNullOrEmpty(Namespace.OriginalValueValidationRegex))
        {
            <dt>@Localizer["App.Namespaces.ValidationRegex"]</dt>
            <dd class="bb:font-mono">@Namespace.OriginalValueValidationRegex</dd>
        }

        <dt>@Localizer["App.Namespaces.AllowsMultiplePseudonymsColumn"]</dt>
        <dd>
            @if (Namespace.AllowsMultiplePseudonyms)
            {
                <LucideIcon Name="check" Size="14" />
            }
            else
            {
                @NotSet
            }
        </dd>

        <dt>@Localizer["App.Namespaces.PseudonymCountColumn"]</dt>
        <dd>
            @if (IsPseudonymCountLoading)
            {
                @* A spinner rather than a BbSkeleton: the skeleton's pulse only fades bg-muted to half
                   opacity, which on a bar this small against the card is barely distinguishable
                   from a static grey box. *@
                <BbSpinner
                    Size="SpinnerSize.Small"
                    AriaLabel="@Localizer["App.Namespaces.PseudonymCountLoading"]"
                />
            }
            else
            {
                @(PseudonymCount is { } count ? count.ToString("N0") : NotSet)
            }
        </dd>

        <dt>@Localizer["App.Namespaces.ProjectsColumn"]</dt>
        <dd class="bb:flex bb:flex-wrap bb:gap-1">
            @if (ProjectNames.Count == 0)
            {
                @NotSet
            }
            else
            {
                @foreach (var projectName in ProjectNames)
                {
                    <a href="@Vfps.Components.Pages.Projects.ProjectHref(projectName)"
                       class="link-pill"
                       title="@Localizer["App.Projects.OpenProject", projectName]"
                       data-project-link="@projectName">
                        <BbBadge Variant="BadgeVariant.Secondary">
                            @projectName
                            <LucideIcon Name="link" Size="12" />
                        </BbBadge>
                    </a>
                }
            }
        </dd>

        <dt>@Localizer["App.Namespaces.ParentColumn"]</dt>
        <dd>
            @if (string.IsNullOrEmpty(Namespace.ParentName))
            {
                @Localizer["App.Namespaces.NoParent"]
            }
            else
            {
                @Namespace.ParentName
                @if (Namespace.ParentValidationMode == Vfps.Protos.ParentValidationMode.EnsureExists)
                {
                    <span class="ml-1 bb:text-muted-foreground">
                        @Localizer["App.Namespaces.ValidatedBadge"]
                    </span>
                }
            }
        </dd>
    </dl>
</div>

@code {
    /// <summary>An en dash, for a value the namespace simply doesn't have.</summary>
    private const string NotSet = "–";

    [Inject]
    private IStringLocalizer<SharedResources> Localizer { get; set; } = null!;

    [Parameter, EditorRequired]
    public Namespace Namespace { get; set; } = null!;

    /// <summary>
    /// The zone timestamps are rendered in. Defaults to UTC, which is also what the page falls
    /// back to when the browser's own zone can't be resolved.
    /// </summary>
    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;

    /// <summary>
    /// The namespace's total pseudonym count, or null while it hasn't been fetched (counting can
    /// take a while, so the caller fetches it separately from the namespace itself and passes it
    /// in once it resolves, rather than this component fetching it - see IsPseudonymCountLoading).
    /// </summary>
    [Parameter]
    public long? PseudonymCount { get; set; }

    /// <summary>
    /// The names of the projects the namespace is in, as far as the caller can see them. Passed in
    /// rather than looked up here: the page has already loaded every project to build its filter.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> ProjectNames { get; set; } = [];

    /// <summary>Whether the caller is still fetching PseudonymCount - shows a spinner in its place.</summary>
    [Parameter]
    public bool IsPseudonymCountLoading { get; set; }

    private string FormatTimestamp(DateTimeOffset timestamp) =>
        TimeZoneInfo.ConvertTime(timestamp, TimeZone).ToString("yyyy-MM-dd HH:mm:ss");
}
