@using System.Security.Claims
@using Vfps.Data.Models
@inject INamespaceAccessGrantAppService GrantAppService
@inject IServiceAccountAppService ServiceAccountAppService
@inject IStringLocalizer<SharedResources> Localizer

@*
    Who can do what in one namespace: a form to add a grant, then the grants scoped to this
    namespace and, read-only, the ones covering every namespace (they apply here too, but belong
    to no single namespace). The Access Control page manages the same grants across all
    namespaces at once through the same app service - this is the per-namespace view of it.
*@

<div>
    @if (_createError is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="bb:mb-4">
            <BbAlertTitle As="p">@Localizer["App.AccessControl.AddGrantErrorTitle"]</BbAlertTitle>
            <BbAlertDescription>@_createError</BbAlertDescription>
        </BbAlert>
    }
    <EditForm Model="_newGrant" FormName="add-namespace-access-grant" OnValidSubmit="CreateGrantAsync">
        <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
            <BbField>
                <BbFieldLabel For="newGrantType">@Localizer["App.AccessControl.GranteeType"]</BbFieldLabel>
                <BbFieldContent>
                    <select
                        value="@_newGrant.GranteeType"
                        @onchange="OnGranteeTypeChanged"
                        id="newGrantType"
                        class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                    >
                        <option value="@GranteeType.Role">@Localizer["App.AccessControl.GranteeTypeRole"]</option>
                        <option value="@GranteeType.Email">@Localizer["App.AccessControl.GranteeTypeEmail"]</option>
                        @if (AreServiceAccountsEnabled)
                        {
                            <option value="@GranteeType.ServiceAccount">
                                @Localizer["App.AccessControl.GranteeTypeServiceAccount"]
                            </option>
                        }
                    </select>
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel For="newGrantGrantee">@Localizer["App.AccessControl.Grantee"]</BbFieldLabel>
                <BbFieldContent>
                    @* A picker rather than a text box for service accounts: unlike a role name or
                       an email address - whose truth lives at the identity provider, so anything
                       typed here is a claim about something this app can't see - a service
                       account is a row in this database, and a grant naming one that doesn't
                       exist could never match anything. *@
                    @if (_newGrant.GranteeType == GranteeType.ServiceAccount)
                    {
                        <select
                            @bind="_newGrant.Grantee"
                            id="newGrantGrantee"
                            class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                        >
                            @foreach (var account in _serviceAccounts)
                            {
                                <option value="@account.Name">@account.Name</option>
                            }
                        </select>
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            @(_serviceAccounts.Count == 0
                                ? Localizer["App.AccessControl.NoServiceAccounts"]
                                : Localizer["App.AccessControl.GranteeServiceAccountHelp"])
                        </p>
                    }
                    else
                    {
                        <BbInput
                            @bind-Value="_newGrant.Grantee"
                            Id="newGrantGrantee"
                            Required="true"
                            Placeholder="@(_newGrant.GranteeType == GranteeType.Email
                                ? Localizer["App.AccessControl.GranteeEmailPlaceholder"].Value
                                : Localizer["App.AccessControl.GranteeRolePlaceholder"].Value)"
                        />
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            @(_newGrant.GranteeType == GranteeType.Email
                                ? Localizer["App.AccessControl.GranteeEmailHelp"]
                                : Localizer["App.AccessControl.GranteeRoleHelp"])
                        </p>
                    }
                </BbFieldContent>
            </BbField>
        </div>
        <div class="bb:mt-4 bb:flex bb:flex-wrap bb:items-center bb:gap-4">
            <div class="bb:flex bb:items-center bb:gap-2">
                <BbSwitch @bind-Checked="_newGrant.CanRead" Id="newGrantCanRead" />
                <label for="newGrantCanRead" class="bb:text-sm">@Localizer["App.AccessControl.Read"]</label>
            </div>
            <div class="bb:flex bb:items-center bb:gap-2">
                <BbSwitch @bind-Checked="_newGrant.CanWrite" Id="newGrantCanWrite" />
                <label for="newGrantCanWrite" class="bb:text-sm">@Localizer["App.AccessControl.Write"]</label>
            </div>
            <div class="bb:flex bb:items-center bb:gap-2">
                <BbSwitch @bind-Checked="_newGrant.CanReverseLookup" Id="newGrantCanReverseLookup" />
                @ReverseLookupLabel("newGrantCanReverseLookup")
            </div>
        </div>
        @* Read and write work with pseudonyms; this one hands back the identifying values they
           stand for. Said in so many words while it's switched on, so it is never granted as if
           it were just one more permission next to the other two. *@
        @if (_newGrant.CanReverseLookup)
        {
            <p class="reveal-note bb:mt-3 bb:text-sm" id="newGrantReverseLookupWarning">
                @Localizer["App.AccessControl.ReverseLookupWarning"]
            </p>
        }
        <BbButton
            id="addAccessGrantButton"
            Type="ButtonType.Submit"
            Loading="_isCreating"
            Class="bb:mt-4"
            IconPosition="IconPosition.Start"
        >
            <Icon>
                <LucideIcon aria-hidden="true" Name="plus" Size="16" />
            </Icon>
            <ChildContent>
                @Localizer["App.AccessControl.AddGrantAction"]
            </ChildContent>
        </BbButton>
    </EditForm>

    @* Below the add controls on purpose: the list grows as grants are added, and above them it
       would push the form further down the dialog with every one. *@
    <div class="bb:mt-4 bb:border-t bb:pt-4">
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger" Class="bb:mb-4">
                <BbAlertTitle As="p">@Localizer["App.AccessControl.GrantErrorTitle"]</BbAlertTitle>
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        @if (_scopedGrants.Count == 0)
        {
            <p class="bb:text-sm bb:text-muted-foreground">
                @Localizer["App.AccessControl.NoGrantsForNamespace"]
            </p>
        }
        else
        {
            <div class="bb:space-y-2">
                @foreach (var grant in _scopedGrants)
                {
                    <div class="bb:rounded-md bb:border bb:border-border bb:p-3">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                            <div class="bb:flex bb:items-center bb:gap-2">
                                <BbBadge Variant="BadgeVariant.Secondary">
                                    @GranteeTypeLabel(grant.GranteeType)
                                </BbBadge>
                                <span class="bb:text-sm">@grant.Grantee</span>
                            </div>
                            @* Confirmed in place rather than in a dialog: this already sits in one,
                               and the row it would delete is right here. *@
                            @if (_pendingDeleteGrantId == grant.Id)
                            {
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                    <span class="bb:text-sm">
                                        @string.Format(
                                            Localizer["App.AccessControl.DeleteGrantConfirm"].Value,
                                            grant.Grantee,
                                            PermissionSummary(grant)
                                        )
                                    </span>
                                    <BbButton
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Small"
                                        OnClick="@(() => _pendingDeleteGrantId = null)"
                                    >
                                        @Localizer["App.Common.Cancel"]
                                    </BbButton>
                                    <BbButton
                                        id="@($"confirmDeleteGrant-{grant.Id}")"
                                        Variant="ButtonVariant.Destructive"
                                        Size="ButtonSize.Small"
                                        Loading="@(_deletingGrantId == grant.Id)"
                                        OnClick="@(() => DeleteGrantAsync(grant))"
                                    >
                                        @Localizer["App.Common.Delete"]
                                    </BbButton>
                                </div>
                            }
                            else
                            {
                                <BbButton
                                    id="@($"deleteGrant-{grant.Id}")"
                                    Variant="ButtonVariant.Outline"
                                    Size="ButtonSize.Small"
                                    Class="destructive-action"
                                    OnClick="@(() => _pendingDeleteGrantId = grant.Id)"
                                >
                                    @Localizer["App.Common.Delete"]
                                </BbButton>
                            }
                        </div>
                        <div class="bb:mt-2 bb:flex bb:flex-wrap bb:items-center bb:gap-4">
                            <div class="bb:flex bb:items-center bb:gap-2">
                                <BbSwitch
                                    @bind-Checked="grant.CanRead"
                                    @bind-Checked:after="@(() => SaveGrantAsync(grant))"
                                    Id="@($"grant-{grant.Id}-read")"
                                    Disabled="@(_savingGrantId == grant.Id || _pendingReverseLookupGrantId == grant.Id)"
                                />
                                <label for="@($"grant-{grant.Id}-read")" class="bb:text-sm">
                                    @Localizer["App.AccessControl.Read"]
                                </label>
                            </div>
                            <div class="bb:flex bb:items-center bb:gap-2">
                                <BbSwitch
                                    @bind-Checked="grant.CanWrite"
                                    @bind-Checked:after="@(() => SaveGrantAsync(grant))"
                                    Id="@($"grant-{grant.Id}-write")"
                                    Disabled="@(_savingGrantId == grant.Id || _pendingReverseLookupGrantId == grant.Id)"
                                />
                                <label for="@($"grant-{grant.Id}-write")" class="bb:text-sm">
                                    @Localizer["App.AccessControl.Write"]
                                </label>
                            </div>
                            <div class="bb:flex bb:items-center bb:gap-2">
                                <BbSwitch
                                    @bind-Checked="grant.CanReverseLookup"
                                    @bind-Checked:after="@(() => OnReverseLookupToggledAsync(grant))"
                                    Id="@($"grant-{grant.Id}-reverse-lookup")"
                                    Disabled="@(_savingGrantId == grant.Id)"
                                />
                                @ReverseLookupLabel($"grant-{grant.Id}-reverse-lookup")
                            </div>
                        </div>
                        @* The other two switches save the moment they flip. Switching this one on
                           waits for an explicit yes, for the reason given on the add form above. *@
                        @if (_pendingReverseLookupGrantId == grant.Id)
                        {
                            <div class="bb:mt-3 bb:space-y-2" id="@($"grant-{grant.Id}-reverse-lookup-confirm")">
                                <p class="reveal-note bb:text-sm">
                                    @Localizer["App.AccessControl.ReverseLookupWarning"]
                                </p>
                                <div class="bb:flex bb:flex-wrap bb:gap-2">
                                    <BbButton
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Small"
                                        OnClick="@(() => CancelReverseLookup(grant))"
                                    >
                                        @Localizer["App.Common.Cancel"]
                                    </BbButton>
                                    <BbButton
                                        id="@($"grant-{grant.Id}-reverse-lookup-allow")"
                                        Size="ButtonSize.Small"
                                        Loading="@(_savingGrantId == grant.Id)"
                                        OnClick="@(() => AllowReverseLookupAsync(grant))"
                                    >
                                        @Localizer["App.AccessControl.ReverseLookupConfirmAction"]
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_globalGrants.Count > 0)
        {
            <div class="bb:mt-4">
                <p class="bb:text-sm bb:font-medium">@Localizer["App.AccessControl.GlobalGrantsTitle"]</p>
                <p class="bb:text-xs bb:text-muted-foreground">
                    @Localizer["App.AccessControl.GlobalGrantsDescription"]
                </p>
                <div class="bb:mt-2 bb:space-y-1">
                    @foreach (var grant in _globalGrants)
                    {
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-sm">
                            <BbBadge Variant="BadgeVariant.Outline">
                                @GranteeTypeLabel(grant.GranteeType)
                            </BbBadge>
                            <span>@grant.Grantee</span>
                            <span class="bb:text-xs bb:text-muted-foreground">@PermissionSummary(grant)</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The namespace whose grants are being edited. Never null - grants covering every
    /// namespace are managed on the Access Control page, and only shown here for context.</summary>
    [Parameter, EditorRequired]
    public string NamespaceName { get; set; } = null!;

    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = null!;

    /// <summary>
    /// Raised after every write, so a host that shows access information of its own can refresh.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Whether the service-account grantee type is offered at all - false when vfps-issued access
    /// tokens are switched off, since an account with no way to authenticate is only a confusing
    /// third option in the list.
    /// </summary>
    [Parameter]
    public bool AreServiceAccountsEnabled { get; set; }

    private readonly NewGrantModel _newGrant = new();
    private List<NamespaceAccessGrant> _scopedGrants = [];
    private List<NamespaceAccessGrant> _globalGrants = [];
    private List<ServiceAccount> _serviceAccounts = [];
    private bool _isCreating;
    private string? _createError;
    private string? _error;
    private Guid? _savingGrantId;

    // The grant whose Delete was clicked, waiting on its in-place confirmation, and the one being
    // deleted right now.
    private Guid? _pendingDeleteGrantId;
    private Guid? _deletingGrantId;

    // The grant whose reverse-lookup switch was turned on but not yet confirmed. Its switch shows
    // on; nothing has been saved.
    private Guid? _pendingReverseLookupGrantId;

    // The namespace the currently loaded grants belong to. Blazor reuses this component instance
    // when the host reopens its dialog for a different namespace, so a parameter change has to
    // reload rather than relying on OnInitializedAsync running again.
    private string? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_loadedFor, NamespaceName, StringComparison.Ordinal))
        {
            _loadedFor = NamespaceName;
            _error = null;
            _createError = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        // Whatever was waiting on an in-row confirmation refers to grants about to be replaced by
        // what the server holds now.
        _pendingDeleteGrantId = null;
        _pendingReverseLookupGrantId = null;

        if (AreServiceAccountsEnabled)
        {
            _serviceAccounts =
            [
                .. await ServiceAccountAppService.GetAllAsync(User, CancellationToken.None),
            ];

            DefaultGranteeToFirstServiceAccount();
        }

        var grants = await GrantAppService.GetAllAsync(User, CancellationToken.None);

        _scopedGrants =
        [
            .. grants
                .Where(g => string.Equals(g.NamespaceName, NamespaceName, StringComparison.Ordinal))
                .OrderBy(g => g.Grantee, StringComparer.Ordinal),
        ];
        _globalGrants =
        [
            .. grants
                .Where(g => g.NamespaceName is null)
                .OrderBy(g => g.Grantee, StringComparer.Ordinal),
        ];
    }

    private async Task CreateGrantAsync()
    {
        _isCreating = true;
        _createError = null;

        try
        {
            await GrantAppService.CreateAsync(
                NamespaceName,
                _newGrant.GranteeType,
                _newGrant.Grantee,
                _newGrant.CanRead,
                _newGrant.CanWrite,
                _newGrant.CanReverseLookup,
                User,
                CancellationToken.None
            );

            _newGrant.Reset();
            await LoadAsync();
            DefaultGranteeToFirstServiceAccount();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task SaveGrantAsync(NamespaceAccessGrant grant)
    {
        _savingGrantId = grant.Id;
        _error = null;

        try
        {
            await GrantAppService.UpdateAsync(
                grant.Id,
                grant.CanRead,
                grant.CanWrite,
                grant.CanReverseLookup,
                User,
                CancellationToken.None
            );
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;

            // The toggle has already flipped locally by the time this runs, so the row would
            // otherwise keep showing a permission that was never persisted.
            await LoadAsync();
        }
        finally
        {
            _savingGrantId = null;
        }
    }

    // Turning reverse lookup on asks first (see the markup); turning it off - including off again
    // while that question is still open - goes through like any other switch, or simply drops
    // the question, since nothing was saved for it.
    private async Task OnReverseLookupToggledAsync(NamespaceAccessGrant grant)
    {
        if (grant.CanReverseLookup)
        {
            _pendingReverseLookupGrantId = grant.Id;
            return;
        }

        if (_pendingReverseLookupGrantId == grant.Id)
        {
            _pendingReverseLookupGrantId = null;
            return;
        }

        await SaveGrantAsync(grant);
    }

    private void CancelReverseLookup(NamespaceAccessGrant grant)
    {
        grant.CanReverseLookup = false;
        _pendingReverseLookupGrantId = null;
    }

    private async Task AllowReverseLookupAsync(NamespaceAccessGrant grant)
    {
        if (_savingGrantId == grant.Id)
        {
            return;
        }

        await SaveGrantAsync(grant);
        _pendingReverseLookupGrantId = null;
    }

    private async Task DeleteGrantAsync(NamespaceAccessGrant grant)
    {
        // Same re-entrancy guard as everywhere else a click starts a server call.
        if (_deletingGrantId == grant.Id)
        {
            return;
        }

        _deletingGrantId = grant.Id;
        _error = null;

        try
        {
            await GrantAppService.DeleteAsync(grant.Id, User, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deletingGrantId = null;
            _pendingDeleteGrantId = null;
        }

        // Reloaded either way: on success to drop the row, on failure because the most likely
        // cause is another admin having already deleted it.
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    // The reverse-lookup switch's label, in the reveal style (wwwroot/app.css) wherever it
    // appears, so the one permission that hands back identifying data never reads like the two
    // beside it.
    private RenderFragment ReverseLookupLabel(string forId) =>
        @<label for="@forId" class="reveal-mark bb:inline-flex bb:items-center bb:gap-1 bb:text-sm">
            <LucideIcon aria-hidden="true" Name="eye" Size="14" />
            @Localizer["App.AccessControl.ReverseLookup"]
        </label>;

    /// <summary>
    /// Switching the grantee type clears the grantee, because the old value can't be right for
    /// the new type - a role name is not an email address, and neither is a service account the
    /// picker has to select by name.
    /// </summary>
    private void OnGranteeTypeChanged(ChangeEventArgs args)
    {
        _newGrant.GranteeType = Enum.TryParse<GranteeType>(args.Value?.ToString(), out var parsed)
            ? parsed
            : GranteeType.Role;
        _newGrant.Grantee = string.Empty;

        DefaultGranteeToFirstServiceAccount();
    }

    /// <summary>
    /// Keeps the picker's displayed selection and the bound value in agreement: a &lt;select&gt;
    /// shows its first option when nothing matches, so an empty grantee would otherwise submit
    /// blank while the form appears to have an account chosen.
    /// </summary>
    private void DefaultGranteeToFirstServiceAccount()
    {
        if (
            _newGrant.GranteeType == GranteeType.ServiceAccount
            && _newGrant.Grantee.Length == 0
            && _serviceAccounts.Count > 0
        )
        {
            _newGrant.Grantee = _serviceAccounts[0].Name;
        }
    }

    private string GranteeTypeLabel(GranteeType granteeType) =>
        granteeType switch
        {
            GranteeType.Email => Localizer["App.AccessControl.GranteeTypeEmail"].Value,
            GranteeType.ServiceAccount =>
                Localizer["App.AccessControl.GranteeTypeServiceAccount"].Value,
            _ => Localizer["App.AccessControl.GranteeTypeRole"].Value,
        };

    private string PermissionSummary(NamespaceAccessGrant grant)
    {
        List<string> permissions = [];

        if (grant.CanRead)
        {
            permissions.Add(Localizer["App.AccessControl.Read"].Value);
        }

        if (grant.CanWrite)
        {
            permissions.Add(Localizer["App.AccessControl.Write"].Value);
        }

        if (grant.CanReverseLookup)
        {
            permissions.Add(Localizer["App.AccessControl.ReverseLookup"].Value);
        }

        return string.Join(", ", permissions);
    }

    private sealed class NewGrantModel
    {
        public GranteeType GranteeType { get; set; } = GranteeType.Role;
        public string Grantee { get; set; } = string.Empty;
        public bool CanRead { get; set; } = true;
        public bool CanWrite { get; set; }
        public bool CanReverseLookup { get; set; }

        /// <summary>
        /// Clears the grantee only. The type and permission toggles are deliberately left as they
        /// were: granting the same set to several roles in a row is the common case.
        /// </summary>
        public void Reset() => Grantee = string.Empty;
    }
}
