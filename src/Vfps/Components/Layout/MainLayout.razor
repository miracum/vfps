@inherits LayoutComponentBase
@using PopoverAlign = BlazorBlueprint.Primitives.PopoverAlign
@using StringInfo = System.Globalization.StringInfo
@using Microsoft.Extensions.Options
@using Vfps.Config
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject IOptions<S3Config> S3ConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer

<BbResponsiveNavProvider>
    <header class="bb:flex bb:h-16 bb:shrink-0 bb:items-center bb:gap-4 bb:border-b bb:bg-background bb:px-4">
        <a href="/ui" class="bb:flex bb:shrink-0 bb:items-center bb:gap-2 bb:font-semibold">
            <img src="img/logo.svg" alt="Vfps logo" class="bb:h-6 bb:w-6 bb:shrink-0" />
        </a>

        <BbResponsiveNavItems Items="@_navItems" />

        <div class="ml-auto bb:flex bb:items-center bb:gap-3">
            <button
                type="button"
                onclick="vfpsToggleDarkMode()"
                aria-label="@Localizer["App.MainLayout.ToggleDarkMode"]"
                class="bb:inline-flex bb:h-10 bb:w-10 bb:items-center bb:justify-center bb:rounded-md bb:hover:bg-accent bb:hover:text-accent-foreground"
            >
                <LucideIcon Name="moon" Size="18" Class="theme-icon-light" />
                <LucideIcon Name="sun" Size="18" Class="theme-icon-dark" />
            </button>

            <div class="bb:flex bb:items-center bb:gap-1 bb:text-xs bb:text-muted-foreground">
                @for (var i = 0; i < SupportedCultures.Length; i++)
                {
                    var culture = SupportedCultures[i];
                    <a
                        href="@BuildCultureUrl(culture)"
                        data-enhance-nav="false"
                        class="bb:rounded bb:px-1.5 bb:py-0.5 bb:uppercase bb:hover:bg-accent bb:hover:text-accent-foreground @(IsCurrentCulture(culture) ? "bb:font-semibold bb:text-foreground" : "")"
                    >
                        @culture
                    </a>
                    @if (i < SupportedCultures.Length - 1)
                    {
                        <span aria-hidden="true">|</span>
                    }
                }
            </div>

            @if (AuthorizationConfigOptions.Value.IsEnabled)
            {
                <AuthorizeView>
                    <Authorized>
                        <div class="bb:flex bb:items-center bb:gap-2">
                            <BbPopover>
                                <BbPopoverTrigger AsChild="false" class="bb:rounded-full bb:cursor-pointer">
                                    <BbAvatar Size="AvatarSize.Small">
                                        <BbAvatarFallback>@Initials(context.User)</BbAvatarFallback>
                                    </BbAvatar>
                                </BbPopoverTrigger>
                                <BbPopoverContent Align="PopoverAlign.End">
                                    @{
                                        var displayName = DisplayName(context.User);
                                        var username = context.User.Identity?.Name;
                                        var email = Email(context.User);
                                        var roles = Roles(context.User);
                                    }
                                    <div class="bb:space-y-3">
                                        <div>
                                            <p class="bb:text-sm bb:font-medium">
                                                @(displayName ?? username ?? Localizer["App.MainLayout.UnknownUser"].Value)
                                            </p>
                                            @if (displayName is not null && username is not null)
                                            {
                                                <p class="bb:text-xs bb:text-muted-foreground">@username</p>
                                            }
                                        </div>
                                        <dl class="bb:space-y-1.5 bb:text-xs">
                                            <div class="bb:flex bb:items-center bb:justify-between bb:gap-2">
                                                <dt class="bb:text-muted-foreground">@Localizer["App.MainLayout.Email"]</dt>
                                                <dd class="bb:truncate">@(email ?? "—")</dd>
                                            </div>
                                            <div>
                                                <dt class="bb:text-muted-foreground">@Localizer["App.MainLayout.Roles"]</dt>
                                                <dd class="bb:mt-1 bb:flex bb:flex-wrap bb:gap-1">
                                                    @if (roles.Count == 0)
                                                    {
                                                        <span class="bb:text-muted-foreground">@Localizer["App.MainLayout.NoRoles"]</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var role in roles)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.Secondary">
                                                                @role
                                                            </BbBadge>
                                                        }
                                                    }
                                                </dd>
                                            </div>
                                        </dl>
                                    </div>
                                </BbPopoverContent>
                            </BbPopover>
                            <form
                                action="/ui/authentication/logout"
                                method="post"
                                @formname="logout"
                            >
                                <AntiforgeryToken />
                                <BbButton
                                    Type="ButtonType.Submit"
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Small"
                                >
                                    @Localizer["App.MainLayout.SignOut"]
                                </BbButton>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <BbButton
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            Href="@LoginUrl"
                        >
                            @Localizer["App.MainLayout.SignIn"]
                        </BbButton>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>

        <BbResponsiveNavTrigger />
    </header>

    <main class="bb:flex-1 bb:overflow-auto bb:p-6">
        @Body
    </main>

    <footer class="bb:shrink-0 bb:border-t bb:px-4 bb:py-3 bb:text-center bb:text-xs bb:text-muted-foreground">
        Vfps v@(AppVersion)
    </footer>
</BbResponsiveNavProvider>

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />

@code {
    // Major.Minor.Build only - Assembly.GetName().Version is a 4-part System.Version whose
    // trailing Revision is always 0 for the <Version> MSBuild sets in Directory.Build.props, so
    // dropping it here avoids a stray ".0" in the displayed version (e.g. "1.7.0", not "1.7.0.0").
    private static string AppVersion
    {
        get
        {
            var version = typeof(MainLayout).Assembly.GetName().Version;
            return version is null ? "unknown" : $"{version.Major}.{version.Minor}.{version.Build}";
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Kept in sync with Program.cs's own supportedCultures array - there's no shared source for
    // this since one lives in a Razor component and the other in top-level statements.
    private static readonly string[] SupportedCultures = ["en", "de"];

    private IReadOnlyList<NavItemDefinition> _navItems = [];

    protected override async Task OnInitializedAsync()
    {
        var items = new List<NavItemDefinition>
        {
            new() { Text = Localizer["App.Nav.Namespaces"], Href = "/ui/namespaces" },
        };

        if (S3ConfigOptions.Value.IsEnabled)
        {
            items.Add(
                new NavItemDefinition { Text = Localizer["App.Nav.CsvProcessing"], Href = "/ui/csv-jobs" }
            );
        }

        // Only meaningful - and only shown - when there are actual role-based rules to display:
        // with authorization disabled everyone already has full access, and a non-admin can't
        // view the page anyway (see AccessControl.razor's own admin check).
        if (AuthorizationConfigOptions.Value.IsEnabled)
        {
            var user =
                AuthenticationState is null
                    ? new ClaimsPrincipal()
                    : (await AuthenticationState).User;

            // Personal access tokens are self-service, so this one is for everyone who is signed
            // in - a token carries only its owner's own access, and managing your own credentials
            // needs no special authority.
            if (AuthorizationConfigOptions.Value.AccessTokens.IsEnabled)
            {
                items.Add(
                    new NavItemDefinition
                    {
                        Text = Localizer["App.Nav.AccessTokens"],
                        Href = "/ui/access-tokens",
                    }
                );
            }

            if (PermissionChecker.IsAdmin(user))
            {
                items.Add(
                    new NavItemDefinition
                    {
                        Text = Localizer["App.Nav.AccessControl"],
                        Href = "/ui/access-control",
                    }
                );

                if (AuthorizationConfigOptions.Value.AccessTokens.IsEnabled)
                {
                    items.Add(
                        new NavItemDefinition
                        {
                            Text = Localizer["App.Nav.ServiceAccounts"],
                            Href = "/ui/service-accounts",
                        }
                    );
                }
            }
        }

        items.Add(new() { Text = Localizer["App.Nav.ApiDocs"], Href = "/swagger" });

        _navItems = items;
    }

    private string LoginUrl => NavigationManager.BuildLoginUrl();

    private bool IsCurrentCulture(string culture) =>
        string.Equals(
            System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            culture,
            StringComparison.OrdinalIgnoreCase
        );

    private string BuildCultureUrl(string culture)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var redirectUri = Uri.EscapeDataString(
            string.IsNullOrEmpty(relativePath) ? "/ui" : $"/ui/{relativePath}"
        );
        return $"/culture/set?culture={culture}&redirectUri={redirectUri}";
    }

    // "name"/"email" are the standard OIDC claim types - not run through .NET's ClaimTypes.*
    // mapping since AddOpenIdConnect sets MapInboundClaims = false (see Program.cs), so these
    // literal strings are what the IdP's token/userinfo claims actually arrive as.
    private static string? DisplayName(ClaimsPrincipal user) => user.FindFirstValue("name");

    private static string? Email(ClaimsPrincipal user) => user.FindFirstValue("email");

    private IReadOnlyList<string> Roles(ClaimsPrincipal user) =>
        user.FindAll(AuthorizationConfigOptions.Value.RoleClaimType).Select(c => c.Value).ToList();

    // The avatar placeholder: the given name's initial followed by the family name's. Read from
    // the "given_name"/"family_name" claims rather than Identity.Name, which is the *login* name
    // here - NameClaimType is "preferred_username" (see Program.cs), so a username like "chgl"
    // would otherwise render as a meaningless "CH". Both claims arrive with the "profile" scope
    // the OIDC handler requests by default, via the userinfo endpoint.
    private static string Initials(ClaimsPrincipal user)
    {
        var given = user.FindFirstValue("given_name");
        var family = user.FindFirstValue("family_name");

        if (!string.IsNullOrWhiteSpace(given) && !string.IsNullOrWhiteSpace(family))
        {
            return (FirstLetter(given) + FirstLetter(family)).ToUpperInvariant();
        }

        // Not every IdP fills in both halves of a user's name, and the split claims are absent
        // entirely for a bearer token that never went through userinfo. Fall back to whichever
        // single name is on offer, then to the login name, so the avatar is never blank.
        var fallback = new[] { given, family, DisplayName(user), user.Identity?.Name }.FirstOrDefault(
            candidate => !string.IsNullOrWhiteSpace(candidate)
        );

        return InitialsFromFullName(fallback);
    }

    private static string InitialsFromFullName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        // A null separator splits on any whitespace, so a tab- or newline-separated name isn't
        // mistaken for a single word.
        var parts = name.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? FirstLetters(parts[0], 2).ToUpperInvariant()
            : (FirstLetter(parts[0]) + FirstLetter(parts[^1])).ToUpperInvariant();
    }

    /// <summary>
    /// The leading <paramref name="count"/> user-perceived characters of <paramref name="value"/>.
    /// Text elements rather than chars, so a name beginning with a surrogate pair or a combining
    /// accent is never sliced in half into an unrenderable fragment.
    /// </summary>
    private static string FirstLetters(string value, int count)
    {
        var trimmed = value.Trim();
        var taken = 0;
        var index = 0;

        while (taken < count && index < trimmed.Length)
        {
            index += StringInfo.GetNextTextElementLength(trimmed, index);
            taken++;
        }

        return trimmed[..index];
    }

    private static string FirstLetter(string value) => FirstLetters(value, 1);
}
