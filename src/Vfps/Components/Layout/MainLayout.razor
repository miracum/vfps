@inherits LayoutComponentBase
@using PopoverAlign = BlazorBlueprint.Primitives.PopoverAlign
@using Microsoft.Extensions.Options
@using Vfps.Config
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject IOptions<S3Config> S3ConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject NavigationManager NavigationManager

<BbResponsiveNavProvider>
    <header class="flex h-16 shrink-0 items-center gap-4 border-b bg-background px-4 md:px-6">
        <a href="/ui" class="flex shrink-0 items-center gap-2 font-semibold">
            <LucideIcon Name="shield-check" Size="22" Class="text-primary" />
            <span>Vfps</span>
        </a>

        <BbResponsiveNavItems Items="@_navItems" />

        <div class="ml-auto flex items-center gap-3">
            <button
                type="button"
                onclick="vfpsToggleDarkMode()"
                aria-label="Toggle dark mode"
                class="inline-flex h-10 w-10 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground"
            >
                <LucideIcon Name="moon" Size="18" Class="dark:hidden" />
                <LucideIcon Name="sun" Size="18" Class="hidden dark:block" />
            </button>

            @if (AuthorizationConfigOptions.Value.IsEnabled)
            {
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-2">
                            <BbPopover>
                                <BbPopoverTrigger AsChild="false" class="rounded-full cursor-pointer">
                                    <BbAvatar Size="AvatarSize.Small">
                                        <BbAvatarFallback>@Initials(context.User.Identity?.Name)</BbAvatarFallback>
                                    </BbAvatar>
                                </BbPopoverTrigger>
                                <BbPopoverContent Align="PopoverAlign.End">
                                    @{
                                        var displayName = DisplayName(context.User);
                                        var username = context.User.Identity?.Name;
                                        var email = Email(context.User);
                                        var roles = Roles(context.User);
                                    }
                                    <div class="space-y-3">
                                        <div>
                                            <p class="text-sm font-medium">
                                                @(displayName ?? username ?? "Unknown user")
                                            </p>
                                            @if (displayName is not null && username is not null)
                                            {
                                                <p class="text-xs text-muted-foreground">@username</p>
                                            }
                                        </div>
                                        <dl class="space-y-1.5 text-xs">
                                            <div class="flex items-center justify-between gap-2">
                                                <dt class="text-muted-foreground">Email</dt>
                                                <dd class="truncate">@(email ?? "—")</dd>
                                            </div>
                                            <div>
                                                <dt class="text-muted-foreground">Roles</dt>
                                                <dd class="mt-1 flex flex-wrap gap-1">
                                                    @if (roles.Count == 0)
                                                    {
                                                        <span class="text-muted-foreground">none</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var role in roles)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.Secondary">
                                                                @role
                                                            </BbBadge>
                                                        }
                                                    }
                                                </dd>
                                            </div>
                                        </dl>
                                    </div>
                                </BbPopoverContent>
                            </BbPopover>
                            <span class="hidden text-sm text-muted-foreground sm:inline">
                                @context.User.Identity?.Name
                            </span>
                            <form
                                action="/ui/authentication/logout"
                                method="post"
                                @formname="logout"
                            >
                                <AntiforgeryToken />
                                <BbButton
                                    Type="ButtonType.Submit"
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Small"
                                >
                                    Sign out
                                </BbButton>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <BbButton
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            Href="@LoginUrl"
                        >
                            Sign in
                        </BbButton>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>

        <BbResponsiveNavTrigger />
    </header>

    <main class="flex-1 overflow-auto p-6 md:p-8">
        @Body
    </main>

    <footer class="shrink-0 border-t px-4 py-3 text-center text-xs text-muted-foreground md:px-6">
        Vfps v@(AppVersion)
    </footer>
</BbResponsiveNavProvider>

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />

@code {
    // Major.Minor.Build only - Assembly.GetName().Version is a 4-part System.Version whose
    // trailing Revision is always 0 for the <Version> MSBuild sets in Directory.Build.props, so
    // dropping it here avoids a stray ".0" in the displayed version (e.g. "1.7.0", not "1.7.0.0").
    private static string AppVersion
    {
        get
        {
            var version = typeof(MainLayout).Assembly.GetName().Version;
            return version is null ? "unknown" : $"{version.Major}.{version.Minor}.{version.Build}";
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<NavItemDefinition> _navItems = [];

    protected override async Task OnInitializedAsync()
    {
        var items = new List<NavItemDefinition>
        {
            new() { Text = "Namespaces", Href = "/ui/namespaces" },
        };

        if (S3ConfigOptions.Value.IsEnabled)
        {
            items.Add(new NavItemDefinition { Text = "CSV Processing", Href = "/ui/csv-jobs" });
        }

        // Only meaningful - and only shown - when there are actual role-based rules to display:
        // with authorization disabled everyone already has full access, and a non-admin can't
        // view the page anyway (see AccessControl.razor's own admin check).
        if (AuthorizationConfigOptions.Value.IsEnabled)
        {
            var user =
                AuthenticationState is null
                    ? new ClaimsPrincipal()
                    : (await AuthenticationState).User;
            if (PermissionChecker.IsAdmin(user))
            {
                items.Add(new NavItemDefinition { Text = "Access Control", Href = "/ui/access-control" });
            }
        }

        _navItems = items;
    }

    private string LoginUrl => NavigationManager.BuildLoginUrl();

    // "name"/"email" are the standard OIDC claim types - not run through .NET's ClaimTypes.*
    // mapping since AddOpenIdConnect sets MapInboundClaims = false (see Program.cs), so these
    // literal strings are what the IdP's token/userinfo claims actually arrive as.
    private static string? DisplayName(ClaimsPrincipal user) => user.FindFirstValue("name");

    private static string? Email(ClaimsPrincipal user) => user.FindFirstValue("email");

    private IReadOnlyList<string> Roles(ClaimsPrincipal user) =>
        user.FindAll(AuthorizationConfigOptions.Value.RoleClaimType).Select(c => c.Value).ToList();

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }
}
