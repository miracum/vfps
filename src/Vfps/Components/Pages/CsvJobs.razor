@page "/csv-jobs"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Vfps.Config
@using Vfps.Data.Models
@inject IOptions<S3Config> S3ConfigOptions
@inject IServiceProvider ServiceProvider
@inject INamespaceAppService NamespaceAppService
@inject INamespacePermissionChecker PermissionChecker
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<CsvJobs> Logger
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.CsvJobs.PageTitle"]</PageTitle>

@if (!S3ConfigOptions.Value.IsEnabled)
{
    <div class="bb:mx-auto">
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>@Localizer["App.CsvJobs.DisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.CsvJobs.DisabledDescription"].Value,
                        "<code>S3__IsEnabled=true</code>",
                        "<code>S3__*</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <div class="bb:mx-auto bb:space-y-6">
        <div class="bb:flex bb:items-center bb:gap-2">
            <LucideIcon Name="file-spreadsheet" Size="24" Class="bb:text-primary" />
            <h1 class="bb:text-2xl bb:font-semibold bb:tracking-tight">@Localizer["App.CsvJobs.PageTitle"]</h1>
        </div>

        @if (S3ConfigOptions.Value.ObjectRetentionDays > 0)
        {
            <BbAlert Variant="AlertVariant.Info">
                <BbAlertDescription>
                    @(S3ConfigOptions.Value.ObjectRetentionDays == 1
                        ? Localizer["App.CsvJobs.RetentionNoticeSingular"].Value
                        : Localizer["App.CsvJobs.RetentionNoticePlural", S3ConfigOptions.Value.ObjectRetentionDays].Value)
                </BbAlertDescription>
            </BbAlert>
        }

        @if (_createError is not null)
        {
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertTitle>@Localizer["App.CsvJobs.CreateErrorTitle"]</BbAlertTitle>
                <BbAlertDescription>@_createError</BbAlertDescription>
            </BbAlert>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.CsvJobs.NewJobTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.CsvJobs.NewJobDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-6">
                <div class="bb:grid bb:gap-4 bb:sm:grid-cols-3">
                    <BbField>
                        <BbFieldLabel For="direction">@Localizer["App.CsvJobs.Direction"]</BbFieldLabel>
                        <BbFieldContent>
                            <select
                                @bind="_direction"
                                @bind:after="OnDirectionChanged"
                                id="direction"
                                class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                            >
                                <option value="@nameof(PseudonymizationJobDirection.Pseudonymize)">
                                    @Localizer["App.CsvJobs.DirectionPseudonymizeOption"]
                                </option>
                                <option value="@nameof(PseudonymizationJobDirection.Depseudonymize)">
                                    @Localizer["App.CsvJobs.DirectionDepseudonymizeOption"]
                                </option>
                                <option value="@nameof(PseudonymizationJobDirection.Import)">
                                    @Localizer["App.CsvJobs.DirectionImportOption"]
                                </option>
                                <option value="@nameof(PseudonymizationJobDirection.Export)">
                                    @Localizer["App.CsvJobs.DirectionExportOption"]
                                </option>
                            </select>
                        </BbFieldContent>
                    </BbField>
                    @* Both of these hand back original values in bulk, so both get the same
                       "this reveals the data" warning the manual reverse-lookup box carries. *@
                    @if (SelectedDirection is PseudonymizationJobDirection.Depseudonymize
                        or PseudonymizationJobDirection.Export)
                    {
                        <BbAlert Variant="AlertVariant.Warning">
                            <BbAlertDescription>
                                @(SelectedDirection == PseudonymizationJobDirection.Export
                                    ? Localizer["App.CsvJobs.ExportWarning"].Value
                                    : Localizer["App.CsvJobs.DepseudonymizeWarning"].Value)
                            </BbAlertDescription>
                        </BbAlert>
                    }
                    @* Only a pseudonymizing job can be told not to create: every other direction
                       either reads pseudonyms or stores pairs the caller already holds. The app
                       service rejects a mode set on one of those rather than ignoring it, so this
                       must not offer one there. *@
                    @if (SelectedDirection == PseudonymizationJobDirection.Pseudonymize)
                    {
                        <BbField>
                            <BbFieldLabel For="pseudonymizeMode">
                                @Localizer["App.CsvJobs.PseudonymizeMode"]
                            </BbFieldLabel>
                            <BbFieldContent>
                                <select
                                    @bind="_pseudonymizeMode"
                                    id="pseudonymizeMode"
                                    class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                                >
                                    <option value="@nameof(PseudonymizeMode.CreateIfMissing)">
                                        @Localizer["App.CsvJobs.PseudonymizeModeCreateIfMissingOption"]
                                    </option>
                                    <option value="@nameof(PseudonymizeMode.FailIfMissing)">
                                        @Localizer["App.CsvJobs.PseudonymizeModeFailIfMissingOption"]
                                    </option>
                                    <option value="@nameof(PseudonymizeMode.BlankIfMissing)">
                                        @Localizer["App.CsvJobs.PseudonymizeModeBlankIfMissingOption"]
                                    </option>
                                </select>
                            </BbFieldContent>
                            @if (SelectedPseudonymizeMode == PseudonymizeMode.BlankIfMissing)
                            {
                                <p class="bb:text-sm bb:text-muted-foreground">
                                    @Localizer["App.CsvJobs.PseudonymizeModeBlankIfMissingHint"]
                                </p>
                            }
                        </BbField>
                    }
                    @* An export has nothing to upload - its rows come from the database - so the
                       file picker and the header-row question don't apply to it. Encoding and
                       delimiter still do: they describe the file being written. *@
                    @if (RequiresInputFile)
                    {
                        <BbField>
                            <BbFieldLabel For="csvFileInput">@Localizer["App.CsvJobs.CsvFile"]</BbFieldLabel>
                            <BbFieldContent>
                                <input
                                    type="file"
                                    id="csvFileInput"
                                    accept=".csv,text/csv"
                                    @onchange="OnFileSelectedAsync"
                                    class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:file:border-0 bb:file:bg-transparent bb:file:text-sm bb:file:font-medium"
                                />
                            </BbFieldContent>
                        </BbField>
                    }

                    <BbField>
                        <BbFieldLabel For="encoding">@Localizer["App.CsvJobs.Encoding"]</BbFieldLabel>
                        <BbFieldContent>
                            <BbInput @bind-Value="_encoding" Id="encoding" />
                        </BbFieldContent>
                    </BbField>
                    <BbField>
                        <BbFieldLabel For="delimiter">@Localizer["App.CsvJobs.Delimiter"]</BbFieldLabel>
                        <BbFieldContent>
                            <BbInput
                                @bind-Value="_delimiter"
                                @bind-Value:after="DetectColumnsAsync"
                                Id="delimiter"
                            />
                        </BbFieldContent>
                    </BbField>
                    @if (RequiresInputFile)
                    {
                        <BbField>
                            <BbFieldLabel For="hasHeaderRow">@Localizer["App.CsvJobs.HeaderRow"]</BbFieldLabel>
                            <BbFieldContent>
                                <div class="bb:flex bb:h-10 bb:items-center bb:gap-2">
                                    <BbCheckbox
                                        Checked="_hasHeaderRow"
                                        CheckedChanged="OnHasHeaderRowChangedAsync"
                                        Id="hasHeaderRow"
                                    />
                                    <label for="hasHeaderRow" class="bb:text-sm">@Localizer["App.CsvJobs.HasHeaderRow"]</label>
                                </div>
                            </BbFieldContent>
                        </BbField>
                    }
                </div>

                @* Import and export both act on exactly one namespace rather than an
                   arbitrary set of column mappings, so each gets its own, much smaller form -
                   see ColumnMapping's own doc comment for how the one mapping they do carry is
                   read back. *@
                @if (IsColumnTransform)
                {
                    <div>
                        <h3 class="bb:text-sm bb:font-medium">@Localizer["App.CsvJobs.ColumnMappings"]</h3>
                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">
                            @if (_direction == nameof(PseudonymizationJobDirection.Depseudonymize))
                            {
                                <text>@Localizer["App.CsvJobs.ColumnMappingsHintDepseudonymize"]</text>
                            }
                            else
                            {
                                <text>@Localizer["App.CsvJobs.ColumnMappingsHintPseudonymize"]</text>
                            }
                            @Localizer["App.CsvJobs.ColumnMappingsHintSuffix"]
                        </p>

                        <div class="bb:mt-3 bb:space-y-3">
                            @foreach (var row in _columnMappings)
                            {
                                <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-2 bb:rounded-lg bb:border bb:p-3">
                                    <BbField Class="bb:w-40 bb:flex-1">
                                        <BbFieldLabel For="@row.SourceColumnId">
                                            @Localizer["App.CsvJobs.SourceColumn"]
                                        </BbFieldLabel>
                                        <BbFieldContent>
                                            <CsvColumnSelector
                                                Value="@row.SourceColumn"
                                                ValueChanged="@(value => row.SourceColumn = value ?? string.Empty)"
                                                Columns="_detectedColumns"
                                                Id="@row.SourceColumnId"
                                                Placeholder="@Localizer["App.CsvJobs.SourceColumnPlaceholder"]"
                                            />
                                        </BbFieldContent>
                                    </BbField>
                                    <BbField Class="bb:w-40 bb:flex-1">
                                        <BbFieldLabel For="@row.TargetColumnId">
                                            @Localizer["App.CsvJobs.TargetColumn"]
                                        </BbFieldLabel>
                                        <BbFieldContent>
                                            <BbInput
                                                @bind-Value="row.TargetColumn"
                                                Id="@row.TargetColumnId"
                                                Placeholder="@Localizer["App.CsvJobs.TargetColumnPlaceholder"]"
                                            />
                                        </BbFieldContent>
                                    </BbField>
                                    <BbField Class="bb:w-40 bb:flex-1">
                                        <BbFieldLabel For="@row.NamespaceId">@Localizer["App.Nav.Namespaces"]</BbFieldLabel>
                                        <BbFieldContent>
                                            <select
                                                @bind="row.Namespace"
                                                id="@row.NamespaceId"
                                                class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                                            >
                                                <option value="">@Localizer["App.CsvJobs.SelectNamespace"]</option>
                                                @foreach (var ns in _namespaces)
                                                {
                                                    <option value="@ns.Name">@ns.Name</option>
                                                }
                                            </select>
                                        </BbFieldContent>
                                    </BbField>
                                    <BbButton
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.Icon"
                                        OnClick="() => RemoveMappingRow(row)"
                                        Disabled="@(_columnMappings.Count == 1)"
                                        AriaLabel="@Localizer["App.CsvJobs.RemoveMapping"]"
                                    >
                                        <LucideIcon Name="x" Size="16" />
                                    </BbButton>
                                </div>
                            }
                        </div>

                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddMappingRow" Class="bb:mt-3">
                            <LucideIcon Name="plus" Size="16" />
                            @Localizer["App.CsvJobs.AddColumnMapping"]
                        </BbButton>
                    </div>
                }
                else
                {
                    @* One form for both: an export picks a namespace, and an import picks the same
                       plus which two columns of its file hold the pair. *@
                    <div>
                        <h3 class="bb:text-sm bb:font-medium">
                            @(!IsImport
                                ? Localizer["App.CsvJobs.ExportTitle"].Value
                                : ImportsIntoNamespaceColumn
                                    // There is no single namespace to name once each row carries
                                    // its own, so the heading stops promising one.
                                    ? Localizer["App.CsvJobs.ImportTitleNamespaceColumn"].Value
                                    : Localizer["App.CsvJobs.ImportTitle"].Value)
                        </h3>
                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">
                            @(IsImport
                                ? Localizer["App.CsvJobs.ImportHint"].Value
                                : Localizer["App.CsvJobs.ExportHint"].Value)
                        </p>

                        <div class="bb:mt-3 bb:flex bb:flex-wrap bb:items-end bb:gap-2 bb:rounded-lg bb:border bb:p-3">
                            @* An import that reads its namespace from a column has no single
                               namespace to pick, so the picker gives way to the column selector
                               below rather than sitting there meaning nothing. *@
                            @if (!ImportsIntoNamespaceColumn)
                            {
                                <BbField Class="bb:w-40 bb:flex-1">
                                    <BbFieldLabel For="jobNamespace">@Localizer["App.Nav.Namespaces"]</BbFieldLabel>
                                    <BbFieldContent>
                                        <select
                                            @bind="_namespaceMapping.Namespace"
                                            id="jobNamespace"
                                            class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                                        >
                                            <option value="">@Localizer["App.CsvJobs.SelectNamespace"]</option>
                                            @foreach (var ns in _namespaces)
                                            {
                                                <option value="@ns.Name">@ns.Name</option>
                                            }
                                        </select>
                                    </BbFieldContent>
                                </BbField>
                            }
                            @* Only an import reads columns; an export writes the two it is told to
                               here by CreateCsvExportJobRequest's own defaults. All three offer
                               the uploaded file's own header row where there is one - the same
                               selector the transform mappings above use. *@
                            @if (IsImport)
                            {
                                <BbField Class="bb:w-40 bb:flex-1">
                                    <BbFieldLabel For="originalValueColumn">
                                        @Localizer["App.CsvJobs.OriginalValueColumn"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <CsvColumnSelector
                                            Value="@_namespaceMapping.SourceColumn"
                                            ValueChanged="@(value => _namespaceMapping.SourceColumn = value ?? string.Empty)"
                                            Columns="_detectedColumns"
                                            Id="originalValueColumn"
                                        />
                                    </BbFieldContent>
                                </BbField>
                                <BbField Class="bb:w-40 bb:flex-1">
                                    <BbFieldLabel For="pseudonymValueColumn">
                                        @Localizer["App.CsvJobs.PseudonymValueColumn"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <CsvColumnSelector
                                            Value="@_namespaceMapping.TargetColumn"
                                            ValueChanged="@(value => _namespaceMapping.TargetColumn = value)"
                                            Columns="_detectedColumns"
                                            Id="pseudonymValueColumn"
                                        />
                                    </BbFieldContent>
                                </BbField>
                                <BbField Class="bb:w-40 bb:flex-1">
                                    <BbFieldLabel For="namespaceColumn">
                                        @Localizer["App.CsvJobs.NamespaceColumn"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <CsvColumnSelector
                                            Value="@_namespaceMapping.NamespaceColumn"
                                            ValueChanged="@(value => _namespaceMapping.NamespaceColumn = value)"
                                            Columns="_detectedColumns"
                                            Id="namespaceColumn"
                                            Placeholder="@Localizer["App.CsvJobs.NamespaceColumnPlaceholder"]"
                                        />
                                    </BbFieldContent>
                                </BbField>
                            }
                        </div>
                        @if (IsImport)
                        {
                            <p class="bb:mt-2 bb:text-sm bb:text-muted-foreground">
                                @(ImportsIntoNamespaceColumn
                                    ? Localizer["App.CsvJobs.NamespaceColumnSetHint"].Value
                                    : Localizer["App.CsvJobs.NamespaceColumnHint"].Value)
                            </p>
                        }
                    </div>
                }

                <BbButton id="submitJobButton" OnClick="CreateJobAsync" Loading="_isCreating">
                    @(RequiresInputFile
                        ? Localizer["App.CsvJobs.UploadAndProcess"].Value
                        : Localizer["App.CsvJobs.StartExport"].Value)
                </BbButton>

                @* Only while the browser-to-S3 PUT itself is in flight - the job already exists
                   server-side by this point (see StartUploadJobAsync), so this is purely local,
                   client-side upload progress, distinct from the per-job processing progress the
                   jobs grid below shows once the runner picks the job up. *@
                @if (_uploadProgressPercent is { } uploadProgressPercent)
                {
                    <div class="bb:max-w-sm bb:space-y-1" id="uploadProgress">
                        <p class="bb:text-sm bb:text-muted-foreground">
                            @Localizer["App.CsvJobs.Uploading"]
                        </p>
                        <BbProgress Value="@uploadProgressPercent" ShowLabel="true" />
                    </div>
                }
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.CsvJobs.JobsTitle"]</BbCardTitle>
                @if (_jobs.Any(j => IsFinished(j.Status)))
                {
                    <BbCardAction>
                        <BbButton
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            OnClick="() => _showClearFinishedConfirm = true"
                        >
                            @Localizer["App.CsvJobs.ClearFinishedJobs"]
                        </BbButton>
                    </BbCardAction>
                }
            </BbCardHeader>
            <BbCardContent>
                @if (_showClearFinishedConfirm)
                {
                    <BbAlert Variant="AlertVariant.Warning" Class="bb:mb-4">
                        <BbAlertTitle>@Localizer["App.CsvJobs.ClearFinishedJobsConfirmTitle"]</BbAlertTitle>
                        <BbAlertDescription>
                            <p class="bb:mb-3">
                                @Localizer["App.CsvJobs.ClearFinishedJobsConfirmBody"]
                            </p>
                            <div class="bb:flex bb:items-center bb:gap-2">
                                <BbButton
                                    Variant="ButtonVariant.Destructive"
                                    Loading="_isClearingFinished"
                                    OnClick="ConfirmClearFinishedJobsAsync"
                                >
                                    @Localizer["App.Common.Clear"]
                                </BbButton>
                                <BbButton
                                    Variant="ButtonVariant.Outline"
                                    OnClick="() => _showClearFinishedConfirm = false"
                                >
                                    @Localizer["App.Common.Cancel"]
                                </BbButton>
                            </div>
                        </BbAlertDescription>
                    </BbAlert>
                }
                @* Explicit page size for the same reason as the namespaces grid: with the
                   pager hidden, the grid's default would silently cut the list off at ten. *@
                <BbDataGrid Items="@_jobs" ShowPagination="false" InitialPageSize="int.MaxValue">
                    <Columns>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.Id"]">
                            <ChildContent Context="j">
                                <code class="bb:text-xs">@j.Id.ToString()[..8]</code>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.File"]">
                            <ChildContent Context="j">
                                <div class="bb:truncate bb:text-xs" title="@JobSubject(j)">
                                    @(JobSubject(j) ?? "—")
                                </div>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.Direction"]">
                            <ChildContent Context="j">
                                @DirectionLabel(j.Direction)
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.Status"]">
                            <ChildContent Context="j">
                                <BbBadge Variant="@BadgeVariantFor(j.Status)" Class="@BadgeClassFor(j.Status)">
                                    @StatusLabel(j.Status)
                                </BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.Progress"]">
                            <ChildContent Context="j">
                                @if (j.TotalBytes > 0)
                                {
                                    <div class="bb:flex bb:items-center bb:gap-2">
                                        <BbProgress Value="@(100.0 * j.BytesProcessed / j.TotalBytes)" Class="bb:w-24" />
                                        <span class="bb:text-xs bb:text-muted-foreground">
                                            @Localizer["App.CsvJobs.RowsCount", j.RowsProcessed]
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="bb:text-xs bb:text-muted-foreground">
                                        @Localizer["App.CsvJobs.RowsCount", j.RowsProcessed]
                                    </span>
                                }
                                @if (ThroughputTextFor(j) is { } throughputText)
                                {
                                    <div class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @throughputText
                                    </div>
                                }
                                @if (j.BadDataRowCount > 0)
                                {
                                    <div
                                        class="bb:mt-1"
                                        title="@Localizer["App.CsvJobs.BadDataRowTitle"]"
                                    >
                                        <BbBadge Variant="BadgeVariant.Outline" Class="badge-warning-amber">
                                            @(j.BadDataRowCount == 1
                                                ? Localizer["App.CsvJobs.WarningCountSingular", j.BadDataRowCount].Value
                                                : Localizer["App.CsvJobs.WarningCountPlural", j.BadDataRowCount].Value)
                                        </BbBadge>
                                    </div>
                                }
                                @if (j.MissingValueCount > 0)
                                {
                                    <div
                                        class="bb:mt-1"
                                        title="@Localizer["App.CsvJobs.MissingValueTitle"]"
                                    >
                                        <BbBadge Variant="BadgeVariant.Outline" Class="badge-warning-amber">
                                            @(j.MissingValueCount == 1
                                                ? Localizer["App.CsvJobs.MissingValueCountSingular", j.MissingValueCount].Value
                                                : Localizer["App.CsvJobs.MissingValueCountPlural", j.MissingValueCount].Value)
                                        </BbBadge>
                                    </div>
                                }
                                @* Its own badge rather than folded into the missing-value one
                                   above: both render as an empty cell in the output and mean
                                   opposite things - "the input had nothing here" versus "the
                                   input had a value this namespace has never seen". *@
                                @if (j.UnresolvedValueCount > 0)
                                {
                                    <div
                                        class="bb:mt-1"
                                        title="@Localizer["App.CsvJobs.UnresolvedValueTitle"]"
                                    >
                                        <BbBadge Variant="BadgeVariant.Outline" Class="badge-warning-amber">
                                            @(j.UnresolvedValueCount == 1
                                                ? Localizer["App.CsvJobs.UnresolvedValueCountSingular", j.UnresolvedValueCount].Value
                                                : Localizer["App.CsvJobs.UnresolvedValueCountPlural", j.UnresolvedValueCount].Value)
                                        </BbBadge>
                                    </div>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.CreatedAt"]">
                            <ChildContent Context="j">
                                @TimeZoneInfo.ConvertTime(j.CreatedAt, _browserTimeZone).ToString(
                                    "yyyy-MM-dd HH:mm:ss"
                                )
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.CsvJobs.Issue"]">
                            <ChildContent Context="j">
                                @if (
                                    (j.Status == PseudonymizationJobStatus.Failed
                                        || j.Status == PseudonymizationJobStatus.Stalled)
                                    && j.ErrorMessage is not null
                                )
                                {
                                    <div
                                        class="bb:flex bb:items-start bb:gap-1.5 bb:text-xs @(j.Status == PseudonymizationJobStatus.Stalled ? "issue-text-stalled" : "bb:text-destructive")"
                                        title="@j.ErrorMessage"
                                    >
                                        <LucideIcon
                                            Name="@(j.Status == PseudonymizationJobStatus.Stalled ? "clock-alert" : "triangle-alert")"
                                            Size="14"
                                            Class="bb:mt-0.5 bb:shrink-0"
                                        />
                                        <span class="bb:truncate">@j.ErrorMessage</span>
                                    </div>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.Common.Actions"]">
                            <ChildContent Context="j">
                                <div class="bb:flex bb:items-center bb:gap-2">
                                    @if (j.Status == PseudonymizationJobStatus.Completed)
                                    {
                                        <BbButton
                                            Variant="ButtonVariant.Outline"
                                            Size="ButtonSize.Small"
                                            OnClick="() => DownloadAsync(j.Id)"
                                        >
                                            @Localizer["App.CsvJobs.Download"]
                                        </BbButton>
                                    }
                                    @if (
                                        j.Status is PseudonymizationJobStatus.AwaitingUpload
                                            or PseudonymizationJobStatus.Queued
                                            or PseudonymizationJobStatus.Running
                                    )
                                    {
                                        <BbButton
                                            Variant="ButtonVariant.Outline"
                                            Size="ButtonSize.Small"
                                            OnClick="() => CancelJobAsync(j.Id)"
                                        >
                                            @Localizer["App.Common.Cancel"]
                                        </BbButton>
                                    }
                                    @* Admins only: the Hangfire dashboard is gated on an admin
                                       role (see Program.cs), so for anyone else this button
                                       could only ever lead to a 403. A job's own creator still
                                       sees its status, progress and failure reason in this grid
                                       - the dashboard adds Hangfire's internal view of it. *@
                                    @if (_isAdmin && j.HangfireJobId is not null)
                                    {
                                        <BbButton
                                            Variant="ButtonVariant.Outline"
                                            Size="ButtonSize.Small"
                                            Href="@HangfireJobDetailsUrl(j.HangfireJobId)"
                                            Target="_blank"
                                        >
                                            @Localizer["App.CsvJobs.ShowJobDashboard"]
                                        </BbButton>
                                    }
                                </div>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                    </Columns>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IPseudonymizationJobAppService? _jobAppService;
    private IReadOnlyList<Namespace> _namespaces = [];
    private readonly List<ColumnMappingRow> _columnMappings = [new()];

    // The single namespace (and, for an import, the two column names) an import or export job
    // acts on. Reuses ColumnMappingRow because that's exactly the shape those jobs store - one
    // ColumnMapping, read back by PseudonymizationJobAppService.ResolveSingleNamespaceMapping.
    // Its generated per-row element ids go unused here: there is only ever one of these on the
    // page, so its fields carry plain literal ids instead. Kept across submits so importing
    // several files into the same namespace doesn't mean re-picking it every time.
    private readonly ColumnMappingRow _namespaceMapping = new()
    {
        SourceColumn = CsvNamespaceColumns.OriginalValue,
        TargetColumn = CsvNamespaceColumns.PseudonymValue,
    };

    private string _direction = nameof(PseudonymizationJobDirection.Pseudonymize);

    // Defaults to today's behavior, which is also what the create-if-not-exist API does: a job
    // submitted without thinking about this question behaves exactly as it always has.
    private string _pseudonymizeMode = nameof(PseudonymizeMode.CreateIfMissing);
    private string _encoding = "utf-8";
    private string _delimiter = ",";
    private bool _hasHeaderRow = true;
    private string? _fileName;
    private IReadOnlyList<string> _detectedColumns = [];
    private bool _isCreating;

    // Set only while StartUploadJobAsync's browser-to-S3 PUT is in flight - see
    // OnUploadProgress. Null the rest of the time, including once the upload finishes, so the
    // progress bar in the markup disappears again rather than getting stuck at 100%.
    private double? _uploadProgressPercent;
    private string? _createError;
    private IReadOnlyList<PseudonymizationJob> _jobs = [];
    private bool _isAdmin;
    private bool _showClearFinishedConfirm;
    private bool _isClearingFinished;

    // Rows/s per job, derived client-side from consecutive polls rather than stored server-side -
    // see UpdateThroughput. Keyed by job id; entries are dropped once the job stops appearing in
    // _jobs (see the prune step there).
    private readonly Dictionary<Guid, (long Rows, DateTimeOffset At)> _lastProgressSnapshot = [];
    private readonly Dictionary<Guid, double> _throughputByJobId = [];

    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;

    private PseudonymizationJobDirection SelectedDirection =>
        Enum.Parse<PseudonymizationJobDirection>(_direction);

    // Only ever sent for a Pseudonymize job - the app service rejects it on any other direction,
    // and the selector that sets it is not rendered there, so a direction change leaving a stale
    // value behind must not reach the request.
    private PseudonymizeMode SelectedPseudonymizeMode =>
        SelectedDirection == PseudonymizationJobDirection.Pseudonymize
            ? Enum.Parse<PseudonymizeMode>(_pseudonymizeMode)
            : PseudonymizeMode.CreateIfMissing;

    // Whether the file picker was on screen before the last direction change - see
    // OnDirectionChanged.
    private bool _hadInputFile = true;

    // Pseudonymize and Depseudonymize share one form (an arbitrary number of column mappings);
    // Import and Export each have their own, single-namespace one.
    private bool IsColumnTransform =>
        SelectedDirection
            is PseudonymizationJobDirection.Pseudonymize
                or PseudonymizationJobDirection.Depseudonymize;

    private bool IsImport => SelectedDirection == PseudonymizationJobDirection.Import;

    // An import whose target namespace comes from a column of the file rather than from the
    // picker. Blank-checked rather than null-checked because clearing the selector back to its
    // empty option yields "" - which has to mean "not set", or the form would look like it had a
    // namespace column while submitting a job with none.
    private bool ImportsIntoNamespaceColumn =>
        IsImport && !string.IsNullOrWhiteSpace(_namespaceMapping.NamespaceColumn);

    // Everything except an export starts with a file the browser uploads straight to S3; an
    // export's rows come from the database, so it has no file picker, no header-row question and
    // no upload step at all.
    private bool RequiresInputFile => SelectedDirection != PseudonymizationJobDirection.Export;

    // Blazor Server renders on the server, so "Created at" starts out shown in UTC until this
    // JS round-trip (OnAfterRenderAsync below) resolves the browser's own IANA time zone name -
    // a brief flash of UTC on first render is an accepted trade-off here, same as the dark-mode
    // theme detection in wwwroot/js/themeToggle.js.
    private TimeZoneInfo _browserTimeZone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        if (!S3ConfigOptions.Value.IsEnabled)
        {
            return;
        }

        _jobAppService = ServiceProvider.GetRequiredService<IPseudonymizationJobAppService>();

        var user = await GetUserAsync();
        _isAdmin = PermissionChecker.IsAdmin(user);
        _namespaces = await NamespaceAppService.GetAllAsync(user, CancellationToken.None);

        await ReloadJobsAsync();

        _pollCts = new CancellationTokenSource();
        _pollTask = PollLoopAsync(_pollCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !S3ConfigOptions.Value.IsEnabled)
        {
            return;
        }

        try
        {
            var ianaId = await JS.InvokeAsync<string>("vfpsTimeZone.get");
            _browserTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ianaId);
        }
        catch (Exception ex)
            when (ex is Microsoft.JSInterop.JSException or TimeZoneNotFoundException)
        {
            // Falls back to the UTC already set as _browserTimeZone's default - a missing/
            // unrecognized zone shouldn't break the page, just leave timestamps in UTC.
            Logger.LogWarning(ex, "Failed to resolve the browser's time zone, defaulting to UTC");
        }

        StateHasChanged();
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await ReloadJobsAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // A transient failure here (e.g. a momentary DB hiccup) must not silently
                    // kill the loop for the rest of the circuit's lifetime - without this, the
                    // grid would stop live-updating until the user does a full page reload
                    // (which spins up a fresh component/loop). Log and retry on the next tick.
                    Logger.LogWarning(ex, "Failed to refresh the CSV jobs list, will retry");
                }
            }
        }
        catch (OperationCanceledException)
        {
            // expected on dispose
        }
    }

    private async Task<ClaimsPrincipal> GetUserAsync() =>
        AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;

    private async Task ReloadJobsAsync()
    {
        if (!S3ConfigOptions.Value.IsEnabled)
        {
            return;
        }

        // A fresh scope (and thus a fresh PseudonymContext) per call, rather than reusing
        // _jobAppService's long-lived one - this method is called from a background
        // PeriodicTimer loop that runs for as long as the component is alive, concurrently with
        // whatever DB calls the interactive handlers below (CreateJobAsync, CancelJobAsync, ...)
        // make through the shared _jobAppService/its underlying scoped DbContext. Two concurrent
        // operations against the same DbContext instance throw "A second operation was started
        // on this context before a previous operation completed" - which used to surface here
        // (e.g. while a user-triggered upload was still in flight when a poll tick landed) and,
        // uncaught, permanently stopped this loop from ever updating the grid again.
        using var scope = ServiceProvider.CreateScope();
        var jobAppService =
            scope.ServiceProvider.GetRequiredService<IPseudonymizationJobAppService>();

        var user = await GetUserAsync();
        _jobs = await jobAppService.ListAsync(user, CancellationToken.None);
        UpdateThroughput(_jobs);
    }

    // Computes each job's rows/s from the delta against its previous snapshot, using the
    // server-recorded LastUpdatedAt (set by UpdateProgressAsync) rather than the client's own
    // poll time - that way the rate reflects the runner's actual wall-clock progress, unaffected
    // by polling jitter or how long this call itself took.
    private void UpdateThroughput(IReadOnlyList<PseudonymizationJob> jobs)
    {
        var seen = new HashSet<Guid>(jobs.Count);
        foreach (var job in jobs)
        {
            seen.Add(job.Id);

            if (
                _lastProgressSnapshot.TryGetValue(job.Id, out var previous)
                && job.LastUpdatedAt > previous.At
            )
            {
                var elapsedSeconds = (job.LastUpdatedAt - previous.At).TotalSeconds;
                var rowDelta = job.RowsProcessed - previous.Rows;
                if (rowDelta > 0)
                {
                    _throughputByJobId[job.Id] = rowDelta / elapsedSeconds;
                }
            }

            _lastProgressSnapshot[job.Id] = (job.RowsProcessed, job.LastUpdatedAt);
        }

        // Drop tracking for jobs no longer in the list, so long-lived circuits that create many
        // jobs over time don't grow these dictionaries unbounded.
        foreach (var staleId in _lastProgressSnapshot.Keys.Where(id => !seen.Contains(id)).ToList())
        {
            _lastProgressSnapshot.Remove(staleId);
            _throughputByJobId.Remove(staleId);
        }
    }

    private string? ThroughputTextFor(PseudonymizationJob job) =>
        job.Status == PseudonymizationJobStatus.Running
        && _throughputByJobId.TryGetValue(job.Id, out var rowsPerSecond)
            ? Localizer["App.CsvJobs.ThroughputRowsPerSecond", rowsPerSecond.ToString("N0")].Value
            : null;

    private string DirectionLabel(PseudonymizationJobDirection direction) =>
        direction switch
        {
            PseudonymizationJobDirection.Depseudonymize =>
                Localizer["App.CsvJobs.DirectionDepseudonymize"],
            PseudonymizationJobDirection.Import => Localizer["App.CsvJobs.DirectionImport"],
            PseudonymizationJobDirection.Export => Localizer["App.CsvJobs.DirectionExport"],
            _ => Localizer["App.CsvJobs.DirectionPseudonymize"],
        };

    // What the "File" column shows. An export has no uploaded file, so it's identified by the
    // namespace it reads instead - the same thing its downloaded file is named after. Read
    // defensively rather than via PseudonymizationJobAppService.ResolveSingleNamespaceMapping:
    // this is a grid cell, and a malformed row should render as "—" rather than throw the whole
    // page's render away.
    private static string? JobSubject(PseudonymizationJob job) =>
        job.Direction == PseudonymizationJobDirection.Export
            ? job.ColumnMappings.FirstOrDefault()?.Namespace
            : job.OriginalFileName;

    private string StatusLabel(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.AwaitingUpload => Localizer["App.CsvJobs.StatusAwaitingUpload"],
            PseudonymizationJobStatus.Queued => Localizer["App.CsvJobs.StatusQueued"],
            PseudonymizationJobStatus.Running => Localizer["App.CsvJobs.StatusRunning"],
            PseudonymizationJobStatus.Completed => Localizer["App.CsvJobs.StatusCompleted"],
            PseudonymizationJobStatus.Failed => Localizer["App.CsvJobs.StatusFailed"],
            PseudonymizationJobStatus.Cancelled => Localizer["App.CsvJobs.StatusCancelled"],
            PseudonymizationJobStatus.Stalled => Localizer["App.CsvJobs.StatusStalled"],
            _ => status.ToString(),
        };

    // NavigationManager.BaseUri already includes the "/ui/" path base (App.razor's <base href>),
    // so appending the dashboard's own relative route gives an absolute link to the Hangfire
    // dashboard's job details page without hardcoding host/port or the "/ui" prefix.
    private string HangfireJobDetailsUrl(string hangfireJobId) =>
        $"{NavigationManager.BaseUri}hangfire/jobs/details/{Uri.EscapeDataString(hangfireJobId)}";

    private static BadgeVariant BadgeVariantFor(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.Failed => BadgeVariant.Destructive,
            // Outline, not Destructive - Stalled is only ever a heuristic guess (see the enum's
            // own doc comment), so the badge shouldn't read as confidently as a confirmed Failed.
            PseudonymizationJobStatus.Stalled => BadgeVariant.Outline,
            PseudonymizationJobStatus.Cancelled => BadgeVariant.Outline,
            PseudonymizationJobStatus.Completed => BadgeVariant.Default,
            _ => BadgeVariant.Secondary,
        };

    // Plain, global CSS classes (wwwroot/app.css), not Tailwind utilities - see that file's own
    // comment for why arbitrary Tailwind classes (and Blazor CSS isolation) don't work here.
    private static string? BadgeClassFor(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.Completed => "badge-completed",
            PseudonymizationJobStatus.Stalled => "badge-warning-amber",
            _ => null,
        };

    private async Task OnHasHeaderRowChangedAsync(bool value)
    {
        _hasHeaderRow = value;
        await DetectColumnsAsync();
    }

    // Runs on every file selection, regardless of _hasHeaderRow - the filename is purely a
    // display label for the jobs list, unrelated to column detection.
    private async Task OnFileSelectedAsync()
    {
        try
        {
            _fileName = await JS.InvokeAsync<string?>(
                "vfpsCsvUpload.getSelectedFileName",
                "csvFileInput"
            );
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _fileName = null;
        }

        await DetectColumnsAsync();
    }

    // Invoked from JS (vfpsCsvUpload.uploadFile's xhr.upload.onprogress) via the
    // DotNetObjectReference passed into that call - see StartUploadJobAsync.
    [JSInvokable]
    public void OnUploadProgress(double loadedBytes, double totalBytes)
    {
        _uploadProgressPercent = totalBytes > 0 ? loadedBytes / totalBytes * 100.0 : 0;
        StateHasChanged();
    }

    private async Task DetectColumnsAsync()
    {
        if (!_hasHeaderRow)
        {
            _detectedColumns = [];
            return;
        }

        try
        {
            _detectedColumns = await JS.InvokeAsync<string[]>(
                "vfpsCsvUpload.readHeaderRow",
                "csvFileInput",
                _delimiter
            );
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _detectedColumns = [];
        }
    }

    private void OnDirectionChanged()
    {
        // The previous direction's error no longer describes what the form now asks for.
        _createError = null;

        // Switching to or from Export tears the file picker out of the DOM (or puts a fresh,
        // empty one back), so the browser has no file selected any more while _fileName and
        // _detectedColumns still describe the one picked before the switch. Only reset on that
        // transition: switching between the two transform directions leaves the same input
        // element - and the file in it - in place, and clearing the detected columns there would
        // drop the source-column dropdowns back to free text for no reason.
        if (RequiresInputFile != _hadInputFile)
        {
            _hadInputFile = RequiresInputFile;
            _fileName = null;
            _detectedColumns = [];
        }
    }

    private void AddMappingRow() => _columnMappings.Add(new ColumnMappingRow());

    private void RemoveMappingRow(ColumnMappingRow row) => _columnMappings.Remove(row);

    private async Task CreateJobAsync()
    {
        if (_jobAppService is null)
        {
            return;
        }

        // Guards against re-entrant invocation - see the identical comment on
        // Namespaces.razor's CreateNamespaceAsync for why this matters under Blazor Server.
        if (_isCreating)
        {
            return;
        }

        _isCreating = true;
        _createError = null;
        try
        {
            var user = await GetUserAsync();
            if (SelectedDirection == PseudonymizationJobDirection.Export)
            {
                await StartExportJobAsync(user);
            }
            else
            {
                await StartUploadJobAsync(user);
            }
        }
        catch (ForbiddenException ex)
        {
            _createError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _createError = ex.Message;
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            _createError = Localizer["App.CsvJobs.UploadFailed", ex.Message];
        }
        finally
        {
            _isCreating = false;
        }
    }

    // Everything but an export: create the job, PUT the file straight to S3 from the browser, and
    // only then tell the server the upload landed.
    private async Task StartUploadJobAsync(ClaimsPrincipal user)
    {
        var mappings = BuildColumnMappings();
        if (mappings is null)
        {
            return;
        }

        var request = new CreateCsvJobRequest(
            _encoding,
            _delimiter,
            _hasHeaderRow,
            mappings,
            SelectedDirection,
            _fileName,
            SelectedPseudonymizeMode
        );
        var (job, uploadUrl) = await _jobAppService!.CreateJobAsync(
            request,
            user,
            CancellationToken.None
        );

        _uploadProgressPercent = 0;
        using (var dotNetRef = DotNetObjectReference.Create(this))
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "vfpsCsvUpload.uploadFile",
                    "csvFileInput",
                    uploadUrl,
                    dotNetRef
                );
            }
            finally
            {
                // Cleared on both success and failure - a failed upload's error is shown via
                // _createError (see CreateJobAsync's catch block), not a stalled progress bar.
                _uploadProgressPercent = null;
            }
        }

        await _jobAppService.MarkUploadCompleteAsync(job.Id, user, CancellationToken.None);

        Toast.Success(
            job.OriginalFileName is null
                ? Localizer["App.CsvJobs.UploadedNoFileName"].Value
                : Localizer["App.CsvJobs.UploadedWithFileName", job.OriginalFileName].Value,
            Localizer["App.CsvJobs.JobCreated"]
        );

        if (IsColumnTransform)
        {
            _columnMappings.Clear();
            _columnMappings.Add(new ColumnMappingRow());
        }

        _detectedColumns = [];
        _fileName = null;
        await ReloadJobsAsync();
    }

    // No file, no upload URL, no AwaitingUpload state - the job is queued the moment it's created.
    private async Task StartExportJobAsync(ClaimsPrincipal user)
    {
        if (string.IsNullOrWhiteSpace(_namespaceMapping.Namespace))
        {
            _createError = Localizer["App.CsvJobs.NoNamespaceError"];
            return;
        }

        await _jobAppService!.CreateExportJobAsync(
            new CreateCsvExportJobRequest(_namespaceMapping.Namespace, _encoding, _delimiter),
            user,
            CancellationToken.None
        );

        Toast.Success(
            Localizer["App.CsvJobs.ExportStarted", _namespaceMapping.Namespace].Value,
            Localizer["App.CsvJobs.JobCreated"]
        );

        await ReloadJobsAsync();
    }

    /// <summary>
    /// The mappings to submit, or null when the form isn't filled in enough to submit at all
    /// (with <see cref="_createError"/> already set to say why).
    /// </summary>
    private IReadOnlyList<ColumnMapping>? BuildColumnMappings()
    {
        if (IsImport)
        {
            if (
                !ImportsIntoNamespaceColumn
                && string.IsNullOrWhiteSpace(_namespaceMapping.Namespace)
            )
            {
                _createError = Localizer["App.CsvJobs.NoNamespaceError"];
                return null;
            }

            if (
                string.IsNullOrWhiteSpace(_namespaceMapping.SourceColumn)
                || string.IsNullOrWhiteSpace(_namespaceMapping.TargetColumn)
            )
            {
                _createError = Localizer["App.CsvJobs.NoImportColumnsError"];
                return null;
            }

            return
            [
                new ColumnMapping
                {
                    SourceColumn = _namespaceMapping.SourceColumn,
                    TargetColumn = _namespaceMapping.TargetColumn,
                    // Left empty when the namespace comes from a column: there is no single one,
                    // and a leftover value from the picker would be a lie about where the rows
                    // went. See ColumnMapping.NamespaceColumn.
                    Namespace = ImportsIntoNamespaceColumn
                        ? string.Empty
                        : _namespaceMapping.Namespace,
                    NamespaceColumn = ImportsIntoNamespaceColumn
                        ? _namespaceMapping.NamespaceColumn
                        : null,
                },
            ];
        }

        var mappings = _columnMappings
            .Where(m =>
                !string.IsNullOrWhiteSpace(m.SourceColumn) && !string.IsNullOrWhiteSpace(m.Namespace)
            )
            .Select(m => new ColumnMapping
            {
                SourceColumn = m.SourceColumn,
                TargetColumn = string.IsNullOrWhiteSpace(m.TargetColumn) ? null : m.TargetColumn,
                Namespace = m.Namespace,
            })
            .ToList();

        if (mappings.Count == 0)
        {
            _createError = Localizer["App.CsvJobs.NoMappingsError"];
            return null;
        }

        return mappings;
    }

    private async Task CancelJobAsync(Guid jobId)
    {
        if (_jobAppService is null)
        {
            return;
        }

        var user = await GetUserAsync();
        await _jobAppService.CancelAsync(jobId, user, CancellationToken.None);
        await ReloadJobsAsync();
    }

    private async Task DownloadAsync(Guid jobId)
    {
        if (_jobAppService is null)
        {
            return;
        }

        var user = await GetUserAsync();
        var url = await _jobAppService.GetDownloadUrlAsync(jobId, user, CancellationToken.None);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private static bool IsFinished(PseudonymizationJobStatus status) =>
        status
            is PseudonymizationJobStatus.Completed
                or PseudonymizationJobStatus.Failed
                or PseudonymizationJobStatus.Cancelled
                or PseudonymizationJobStatus.Stalled;

    private async Task ConfirmClearFinishedJobsAsync()
    {
        // Guards against re-entrant invocation - see the identical comment on
        // Namespaces.razor's CreateNamespaceAsync for why this matters under Blazor Server.
        if (_jobAppService is null || _isClearingFinished)
        {
            return;
        }

        _isClearingFinished = true;
        try
        {
            var user = await GetUserAsync();
            await _jobAppService.ClearFinishedAsync(user, CancellationToken.None);
            _showClearFinishedConfirm = false;
            await ReloadJobsAsync();
        }
        finally
        {
            _isClearingFinished = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        if (_pollTask is not null)
        {
            try
            {
                await _pollTask;
            }
            catch (OperationCanceledException)
            {
                // expected
            }
        }

        _pollCts?.Dispose();
    }

    private sealed class ColumnMappingRow
    {
        // A stable per-row id, distinct from list position - looping with a mutable index
        // variable and using it inside nested components' Id parameters isn't safe here, since
        // those parameters are captured by reference in the surrounding ChildContent closures.
        private readonly string _id = Guid.NewGuid().ToString("N");

        public string SourceColumnId => $"sourceColumn-{_id}";
        public string TargetColumnId => $"targetColumn-{_id}";
        public string NamespaceId => $"namespace-{_id}";

        public string SourceColumn { get; set; } = string.Empty;
        public string? TargetColumn { get; set; }
        public string Namespace { get; set; } = string.Empty;

        // Import only, and only ever on the single _namespaceMapping row - see
        // ColumnMapping.NamespaceColumn.
        public string? NamespaceColumn { get; set; }
    }
}
