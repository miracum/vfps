@page "/access-control"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Vfps.Config
@using Vfps.Data.Models
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject INamespaceAppService NamespaceAppService
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.Nav.AccessControl"]</PageTitle>

@{
    RenderFragment<IReadOnlyList<string>> RoleBadges = roles =>
        @<div class="flex flex-wrap gap-1">
            @if (roles.Count == 0)
            {
                <span class="text-xs text-muted-foreground">—</span>
            }
            else
            {
                @foreach (var role in roles)
                {
                    <BbBadge Variant="BadgeVariant.Outline">@role</BbBadge>
                }
            }
        </div>;
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex items-center gap-2">
        <LucideIcon Name="shield" Size="24" Class="text-primary" />
        <h1 class="text-2xl font-semibold tracking-tight">@Localizer["App.Nav.AccessControl"]</h1>
    </div>

    @if (!AuthorizationConfigOptions.Value.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessControl.DisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessControl.DisabledDescription"].Value,
                        "<code>Authorization__IsEnabled</code>",
                        "<code>false</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else if (!_isAdmin)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>@Localizer["App.AccessControl.AdminsOnlyTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @Localizer["App.AccessControl.AdminsOnlyDescription"]
            </BbAlertDescription>
        </BbAlert>
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.AccessControl.AdminRolesTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.AccessControl.AdminRolesDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @RoleBadges(AuthorizationConfigOptions.Value.AdminRoles)
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.AccessControl.NamespaceRulesTitle"]</BbCardTitle>
                <BbCardDescription>
                    @((MarkupString)
                        string.Format(
                            Localizer["App.AccessControl.NamespaceRulesDescription"].Value,
                            "<code>Authorization:NamespaceRules</code>",
                            "<code>*</code>"
                        ))
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (AuthorizationConfigOptions.Value.NamespaceRules.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">
                        @Localizer["App.AccessControl.NoNamespaceRules"]
                    </p>
                }
                else
                {
                    <BbDataGrid
                        Items="@AuthorizationConfigOptions.Value.NamespaceRules"
                        ShowPagination="false"
                    >
                        <Columns>
                            <BbDataGridTemplateColumn Title="@Localizer["App.Nav.Namespaces"]">
                                <ChildContent Context="rule">
                                    @(rule.Namespace == "*"
                                        ? Localizer["App.AccessControl.AllNamespaces"].Value
                                        : rule.Namespace)
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Read"]">
                                <ChildContent Context="rule">@RoleBadges(rule.ReadRoles)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Write"]">
                                <ChildContent Context="rule">@RoleBadges(rule.WriteRoles)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.ReverseLookup"]">
                                <ChildContent Context="rule">
                                    @RoleBadges(rule.ReverseLookupRoles)
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                }
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.AccessControl.EffectiveAccessTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.AccessControl.EffectiveAccessDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_namespaces.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.AccessControl.NoNamespacesExist"]</p>
                }
                else
                {
                    <BbDataGrid Items="@_namespaces" ShowPagination="false">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(n => n.Name)" Title="@Localizer["App.Nav.Namespaces"]" />
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Read"]">
                                <ChildContent Context="n">
                                    @RoleBadges(ResolvedRoles(n.Name, r => r.ReadRoles))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Write"]">
                                <ChildContent Context="n">
                                    @RoleBadges(ResolvedRoles(n.Name, r => r.WriteRoles))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.ReverseLookup"]">
                                <ChildContent Context="n">
                                    @RoleBadges(ResolvedRoles(n.Name, r => r.ReverseLookupRoles))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _isAdmin;
    private IReadOnlyList<Namespace> _namespaces = [];

    protected override async Task OnInitializedAsync()
    {
        var user =
            AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        _isAdmin = PermissionChecker.IsAdmin(user);

        // Only an admin's own listing is guaranteed to be the full set - GetAllAsync filters to
        // what the caller can read, and a non-admin has already been turned away above.
        if (AuthorizationConfigOptions.Value.IsEnabled && _isAdmin)
        {
            _namespaces = await NamespaceAppService.GetAllAsync(user, CancellationToken.None);
        }
    }

    private List<string> ResolvedRoles(
        string namespaceName,
        Func<NamespaceRule, List<string>> roleSelector
    ) =>
        [
            .. AuthorizationConfigOptions
                .Value.NamespaceRules.Where(r =>
                    r.Namespace == "*" || r.Namespace == namespaceName
                )
                .SelectMany(roleSelector)
                .Distinct()
                .OrderBy(r => r, StringComparer.Ordinal),
        ];
}
