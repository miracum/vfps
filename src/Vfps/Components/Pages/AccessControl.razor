@page "/access-control"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Vfps.Config
@using Vfps.Data.Models
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject INamespaceAppService NamespaceAppService
@inject INamespaceAccessGrantAppService GrantAppService
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.Nav.AccessControl"]</PageTitle>

@{
    RenderFragment<IReadOnlyList<string>> Badges = values =>
        @<div class="flex flex-wrap gap-1">
            @if (values.Count == 0)
            {
                <span class="text-xs text-muted-foreground">—</span>
            }
            else
            {
                @foreach (var value in values)
                {
                    <BbBadge Variant="BadgeVariant.Outline">@value</BbBadge>
                }
            }
        </div>;
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex items-center gap-2">
        <LucideIcon Name="shield" Size="24" Class="text-primary" />
        <h1 class="text-2xl font-semibold tracking-tight">@Localizer["App.Nav.AccessControl"]</h1>
    </div>

    @if (!AuthorizationConfigOptions.Value.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessControl.DisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessControl.DisabledDescription"].Value,
                        "<code>Authorization__IsEnabled</code>",
                        "<code>false</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else if (!_isAdmin)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>@Localizer["App.AccessControl.AdminsOnlyTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @Localizer["App.AccessControl.AdminsOnlyDescription"]
            </BbAlertDescription>
        </BbAlert>
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.AccessControl.AdminRolesTitle"]</BbCardTitle>
                <BbCardDescription>
                    @((MarkupString)
                        string.Format(
                            Localizer["App.AccessControl.AdminRolesDescription"].Value,
                            "<code>Authorization__AdminRoles</code>"
                        ))
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @Badges(AuthorizationConfigOptions.Value.AdminRoles)
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.AccessControl.EffectiveAccessTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.AccessControl.EffectiveAccessDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_namespaces.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.AccessControl.NoNamespacesExist"]</p>
                }
                else
                {
                    <BbDataGrid Items="@_namespaces" ShowPagination="false" InitialPageSize="int.MaxValue">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(n => n.Name)" Title="@Localizer["App.Nav.Namespaces"]" />
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Read"]">
                                <ChildContent Context="n">
                                    @Badges(GranteesFor(n.Name, g => g.CanRead))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.Write"]">
                                <ChildContent Context="n">
                                    @Badges(GranteesFor(n.Name, g => g.CanWrite))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="@Localizer["App.AccessControl.ReverseLookup"]">
                                <ChildContent Context="n">
                                    @Badges(GranteesFor(n.Name, g => g.CanReverseLookup))
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal _user = new();
    private bool _isAdmin;
    private IReadOnlyList<Namespace> _namespaces = [];
    private IReadOnlyList<NamespaceAccessGrant> _grants = [];

    protected override async Task OnInitializedAsync()
    {
        _user =
            AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        _isAdmin = PermissionChecker.IsAdmin(_user);

        if (AuthorizationConfigOptions.Value.IsEnabled && _isAdmin)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        // An admin's own listing is the full set - GetAllAsync filters to what the caller can
        // read, and a non-admin has already been turned away above.
        _namespaces = await NamespaceAppService.GetAllAsync(_user, CancellationToken.None);
        _grants = await GrantAppService.GetAllAsync(_user, CancellationToken.None);
    }

    /// <summary>
    /// Everyone holding a given permission on a namespace: the grants scoped to it plus the ones
    /// that apply to every namespace, which is the same union the permission checks themselves
    /// resolve.
    /// </summary>
    private List<string> GranteesFor(
        string namespaceName,
        Func<NamespaceAccessGrant, bool> hasPermission
    ) =>
        [
            .. _grants
                .Where(g =>
                    (g.NamespaceName is null || g.NamespaceName == namespaceName)
                    && hasPermission(g)
                )
                .Select(g => g.Grantee)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(g => g, StringComparer.Ordinal),
        ];
}
