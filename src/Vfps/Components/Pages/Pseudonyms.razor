@page "/namespaces/{NamespaceName}/pseudonyms"
@rendermode InteractiveServer
@inject IPseudonymAppService PseudonymAppService
@inject INamespaceAppService NamespaceAppService
@inject INamespacePermissionChecker PermissionChecker
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.Pseudonyms.PageTitle", NamespaceName]</PageTitle>

<div class="bb:mx-auto bb:space-y-6">
    <div>
        <BbButton Variant="ButtonVariant.Link" Href="/ui/namespaces" Class="bb:px-0">
            <LucideIcon Name="arrow-left" Size="16" />
            @Localizer["App.Pseudonyms.BackToNamespaces"]
        </BbButton>
        <div class="bb:flex bb:items-center bb:gap-2">
            <LucideIcon Name="key-round" Size="24" Class="bb:text-primary" />
            <h1 class="bb:text-2xl bb:font-semibold bb:tracking-tight">@Localizer["App.Pseudonyms.Heading", NamespaceName]</h1>
        </div>
    </div>

    <div class="bb:grid bb:gap-6 bb:md:grid-cols-2">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.Pseudonyms.CreateTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.Pseudonyms.CreateDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-3">
                <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-2">
                    <BbField Class="bb:w-full bb:max-w-sm">
                        <BbFieldLabel For="originalValue">@Localizer["App.Pseudonyms.OriginalValue"]</BbFieldLabel>
                        <BbFieldContent>
                            <BbInput @bind-Value="_createValue" Id="originalValue" Required="true" />
                        </BbFieldContent>
                    </BbField>
                    @if (_allowsMultiplePseudonyms)
                    {
                        <BbField Class="bb:w-24">
                            <BbFieldLabel For="createCount">@Localizer["App.Pseudonyms.CreateCount"]</BbFieldLabel>
                            <BbFieldContent>
                                <BbNumericInput TValue="int" @bind-Value="_createCount" Id="createCount" Min="1" />
                            </BbFieldContent>
                        </BbField>
                    }
                    <BbButton OnClick="CreatePseudonymAsync" Loading="_isCreating">@Localizer["App.Common.Create"]</BbButton>
                </div>
                @if (_createError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_createError</BbAlertDescription>
                    </BbAlert>
                }
                @if (_createResults.Count > 0)
                {
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-sm">
                        <span>@Localizer["App.Pseudonyms.PseudonymLabel"]:</span>
                        @foreach (var p in _createResults)
                        {
                            <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5">@p.PseudonymValue</code>
                        }
                    </div>
                }
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.Pseudonyms.ReverseLookupTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.Pseudonyms.ReverseLookupDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-3">
                <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-2">
                    <BbField Class="bb:w-full bb:max-w-sm">
                        <BbFieldLabel For="lookupValue">@Localizer["App.Pseudonyms.PseudonymValue"]</BbFieldLabel>
                        <BbFieldContent>
                            <BbInput @bind-Value="_lookupValue" Id="lookupValue" />
                        </BbFieldContent>
                    </BbField>
                    <BbButton OnClick="ReverseLookupAsync" Loading="_isLookingUp">@Localizer["App.Pseudonyms.LookUp"]</BbButton>
                </div>
                @if (_lookupError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_lookupError</BbAlertDescription>
                    </BbAlert>
                }
                @if (_lookupResult is not null)
                {
                    <p class="bb:text-sm">
                        @Localizer["App.Pseudonyms.OriginalValueLabel"]: <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5">@_lookupResult.OriginalValue</code>
                    </p>
                }
            </BbCardContent>
        </BbCard>
    </div>

    @if (_chainSourceValue is not null)
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.Pseudonyms.ChainTitle"]</BbCardTitle>
                <BbCardDescription>
                    @Localizer["App.Pseudonyms.ChainDescription", NamespaceName]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-3">
                <p class="bb:text-sm">
                    @Localizer["App.Pseudonyms.ChainOriginalValue"]:
                    <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5 bb:text-xs">@_chainSourceValue</code>
                </p>
                <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-2">
                    <BbField Class="bb:w-full bb:max-w-sm">
                        <BbFieldLabel For="chainTarget">@Localizer["App.Pseudonyms.ChainTarget"]</BbFieldLabel>
                        <BbFieldContent>
                            <select
                                @bind="_chainTargetNamespace"
                                id="chainTarget"
                                class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-background bb:px-3 bb:py-2 bb:text-sm bb:focus-visible:outline-none bb:disabled:cursor-not-allowed bb:disabled:opacity-50"
                            >
                                @foreach (var child in _children)
                                {
                                    <option value="@child.Name">@child.Name</option>
                                }
                            </select>
                        </BbFieldContent>
                    </BbField>
                    <BbButton OnClick="ChainPseudonymAsync" Loading="_isChaining">
                        @Localizer["App.Common.Create"]
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelChain">
                        @Localizer["App.Common.Cancel"]
                    </BbButton>
                </div>
                @if (_chainError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_chainError</BbAlertDescription>
                    </BbAlert>
                }
                @if (_chainResult is not null)
                {
                    <p class="bb:text-sm">
                        @Localizer["App.Pseudonyms.PseudonymLabel"]:
                        <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5">@_chainResult.PseudonymValue</code>
                        <BbButton
                            Variant="ButtonVariant.Link"
                            Size="ButtonSize.Small"
                            Href="@($"/ui/namespaces/{Uri.EscapeDataString(_chainResult.NamespaceName)}/pseudonyms")"
                        >
                            @Localizer["App.Common.Browse"]
                        </BbButton>
                    </p>
                }
            </BbCardContent>
        </BbCard>
    }

    @if (_errorMessage is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>@Localizer["App.Pseudonyms.LoadErrorTitle"]</BbAlertTitle>
            <BbAlertDescription>@_errorMessage</BbAlertDescription>
        </BbAlert>
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.Nav.Pseudonyms"]</BbCardTitle>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-4">
                @* Our own search form instead of the grid's ShowSearch box: that one searches a
                   debounce after every keystroke, and on a large namespace each of those is a
                   query. Here a search runs on Enter or the button. The input reports every
                   keystroke rather than on change, so the submit handler always sees all of what
                   was typed. *@
                <form class="bb:flex bb:items-center bb:gap-2" role="search" @onsubmit="SubmitSearch">
                    <BbInput
                        Type="InputType.Search"
                        @bind-Value="_searchInput"
                        UpdateTiming="UpdateTiming.Immediate"
                        Id="pseudonymSearch"
                        Placeholder="@(_hasReverseLookupAccess ? Localizer["App.Pseudonyms.SearchWithOriginalValuePlaceholder"] : Localizer["App.Pseudonyms.SearchPlaceholder"])"
                        AriaLabel="@(_hasReverseLookupAccess ? Localizer["App.Pseudonyms.SearchWithOriginalValuePlaceholder"] : Localizer["App.Pseudonyms.SearchPlaceholder"])"
                        Class="bb:max-w-sm"
                    />
                    <BbButton Type="ButtonType.Submit">
                        <LucideIcon Name="search" Size="16" />
                        @Localizer["App.Common.Search"]
                    </BbButton>
                    @if (_isSearching)
                    {
                        @* Not a disabled Search button: the search can be interrupted, which is
                           the point of showing that one is running. *@
                        <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick="CancelSearch">
                            <BbSpinner Size="SpinnerSize.Small" AriaLabel="@Localizer["App.Pseudonyms.SearchInProgress"]" />
                            @Localizer["App.Common.Cancel"]
                        </BbButton>
                    }
                </form>
                <BbDataGrid
                    @key="_run"
                    @ref="_grid"
                    TData="PseudonymSearchItemDto"
                    ItemsProvider="_itemsProvider"
                    InitialPageSize="PageSize"
                    IsLoading="_isLoading"
                >
                    <LoadingTemplate>
                        @* Mimics the grid's own row layout instead of the default "Loading..."
                           text, so the initial fetch doesn't read as an empty table. Shown for
                           the first load and while a search runs (see _isLoading), not on every
                           page fetch - those already have rows on screen. *@
                        <div class="bb:space-y-3 bb:py-2">
                            @for (var i = 0; i < 6; i++)
                            {
                                <div class="bb:flex bb:items-center bb:gap-4">
                                    <BbSkeleton Height="16px" Width="25%" />
                                    <BbSkeleton Height="16px" Width="25%" />
                                    <BbSkeleton Height="16px" Width="20%" />
                                    <BbSkeleton Height="16px" Width="20%" />
                                </div>
                            }
                        </div>
                    </LoadingTemplate>
                    <Columns>
                        @* A property column with a cell template rather than a template column:
                           the pseudonym stays sortable and filterable like any other property,
                           it just renders in the same <code> style as the original value beside
                           it - the two are the same kind of value and read better matching. *@
                        <BbDataGridPropertyColumn
                            Property="@(p => p.PseudonymValue)"
                            Title="@Localizer["App.Pseudonyms.PseudonymLabel"]"
                        >
                            <CellTemplate Context="p">
                                <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5 bb:text-xs">@p.PseudonymValue</code>
                            </CellTemplate>
                        </BbDataGridPropertyColumn>
                        <BbDataGridTemplateColumn Title="@Localizer["App.Pseudonyms.OriginalValueLabel"]">
                            <ChildContent Context="p">
                                @if (p.OriginalValue is { } revealed)
                                {
                                    <code class="bb:rounded bb:bg-muted bb:px-1.5 bb:py-0.5 bb:text-xs">@revealed</code>
                                }
                                else
                                {
                                    <span class="bb:text-muted-foreground">&mdash;</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridPropertyColumn
                            Property="@(p => p.CreatedAt)"
                            Title="@Localizer["App.Pseudonyms.CreatedAt"]"
                            Format="yyyy-MM-dd HH:mm:ss"
                        />
                        <BbDataGridPropertyColumn
                            Property="@(p => p.LastUpdatedAt)"
                            Title="@Localizer["App.Pseudonyms.LastUpdated"]"
                            Format="yyyy-MM-dd HH:mm:ss"
                        />
                        @if (_children.Count > 0)
                        {
                            <BbDataGridTemplateColumn Title="@Localizer["App.Common.Actions"]">
                                <ChildContent Context="p">
                                    <BbButton
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Small"
                                        OnClick="() => StartChain(p.PseudonymValue)"
                                    >
                                        @Localizer["App.Pseudonyms.ChainAction"]
                                    </BbButton>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        }
                    </Columns>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private const int PageSize = 25;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Parameter]
    public string NamespaceName { get; set; } = string.Empty;

    private BlazorBlueprint.Components.BbDataGrid<PseudonymSearchItemDto>? _grid;
    private string? _errorMessage;

    // Starts true so the grid shows LoadingTemplate instead of an empty table while
    // FetchAsync's first fetch is in flight, and is set again while a search runs - the
    // old rows would otherwise sit there as if they were its answer. Page and sort fetches leave
    // it false: those already have rows on screen, so a full-grid loading takeover would just
    // flicker instead of helping.
    private bool _isLoading = true;

    // What is typed in the search box. The search the grid runs only changes on Enter or the
    // Search button, which is when this is copied into a new SearchRun.
    private string? _searchInput;

    // The search the grid on screen belongs to. Every search gets a grid of its own (the grid
    // can't be told to go back to page 1, nor does it pick up a changed SearchText), by using the
    // run as the grid's @key - and that grid's ItemsProvider is bound to the run, so a grid that
    // is on its way out can never read or change the state of the search that replaced it.
    private SearchRun _run = new(null, isUserSearch: false);
    private BlazorBlueprint.Primitives.DataGrid.DataGridItemsProvider<PseudonymSearchItemDto> _itemsProvider = null!;

    // The search whose rows are on screen - what a cancelled search goes back to - and the first
    // page of them, so that going back doesn't have to run that search again: on a large
    // namespace that is seconds of skeleton right after asking for the opposite.
    private string? _shownSearch;
    private BlazorBlueprint.Primitives.DataGrid.DataGridResult<PseudonymSearchItemDto>? _shownFirstPage;

    // True while a search runs, and the reason for the Cancel button. Only a search the reader
    // asked for counts - a page change isn't one, and cancelling it would leave the grid showing
    // another page than the one it is on.
    private bool _isSearching;

    private sealed class SearchRun(string? text, bool isUserSearch)
    {
        public string? Text { get; } = text;

        // False for the page's first load and for putting back a cancelled search's predecessor.
        public bool IsUserSearch { get; } = isUserSearch;

        // Whether the first page of the shown search is to be reused instead of fetched.
        public bool RestoreShownFirstPage { get; init; }

        public bool Started { get; set; }
        public bool Cancelled { get; set; }
        public CancellationTokenSource? Cts { get; set; }
    }

    // Only used to pick the search placeholder text below - FetchAsync re-derives this
    // server-side on every request via PseudonymAppService.SearchAsync, so this flag being stale
    // (e.g. permissions changed mid-session) can't let anyone search original values they aren't
    // allowed to see.
    private bool _hasReverseLookupAccess;

    private string _lookupValue = string.Empty;
    private bool _isLookingUp;
    private string? _lookupError;
    private Vfps.Data.Models.Pseudonym? _lookupResult;

    private string _createValue = string.Empty;
    private int _createCount = 1;
    private bool _isCreating;
    private string? _createError;
    private IReadOnlyList<Vfps.Data.Models.Pseudonym> _createResults = [];

    // Whether this namespace allows more than one pseudonym per original value - gates the count
    // input above the create form; a non-multi namespace never needs it, since CreateAsync always
    // rejects a count above 1 for one anyway.
    private bool _allowsMultiplePseudonyms;

    // The child namespaces this one can chain into - drives the per-row "pseudonymize into"
    // action, which is hidden entirely when this namespace has no children.
    private IReadOnlyList<Vfps.Data.Models.Namespace> _children = [];

    private string? _chainSourceValue;
    private string _chainTargetNamespace = string.Empty;
    private bool _isChaining;
    private string? _chainError;
    private Vfps.Data.Models.Pseudonym? _chainResult;

    protected override async Task OnInitializedAsync()
    {
        StartRun(_run);
        var user = await GetUserAsync();
        _hasReverseLookupAccess = await PermissionChecker.HasReverseLookupAccessAsync(
            user,
            NamespaceName,
            CancellationToken.None
        );

        try
        {
            _children = await NamespaceAppService.ListChildrenAsync(
                NamespaceName,
                user,
                CancellationToken.None
            );
        }
        catch (Exception ex) when (ex is NamespaceNotFoundException or ForbiddenException)
        {
            // Left empty rather than surfaced: the grid below reports the same condition through
            // FetchAsync, and a missing chaining action is not worth a second error banner.
            _children = [];
        }

        try
        {
            var @namespace = await NamespaceAppService.GetAsync(
                NamespaceName,
                user,
                CancellationToken.None
            );
            _allowsMultiplePseudonyms = @namespace.AllowsMultiplePseudonyms;
        }
        catch (Exception ex) when (ex is NamespaceNotFoundException or ForbiddenException)
        {
            // Same reasoning as _children above: left false rather than surfaced here.
            _allowsMultiplePseudonyms = false;
        }
    }

    private void StartChain(string pseudonymValue)
    {
        _chainSourceValue = pseudonymValue;
        _chainTargetNamespace = _children[0].Name;
        _chainError = null;
        _chainResult = null;
    }

    private void CancelChain()
    {
        _chainSourceValue = null;
        _chainError = null;
        _chainResult = null;
    }

    private async Task ChainPseudonymAsync()
    {
        // Same re-entrancy guard as CreatePseudonymAsync above.
        if (_isChaining || _chainSourceValue is null)
        {
            return;
        }

        _isChaining = true;
        _chainError = null;
        _chainResult = null;
        try
        {
            var user = await GetUserAsync();
            // This namespace's pseudonym value becomes the child namespace's original value -
            // that chaining is the whole point of a parent/child hierarchy.
            var created = await PseudonymAppService.CreateAsync(
                _chainTargetNamespace,
                _chainSourceValue,
                1,
                user,
                CancellationToken.None
            );
            _chainResult = created[0];
        }
        catch (Exception ex)
            when (ex
                    is NamespaceNotFoundException
                        or ParentPseudonymNotFoundException
                        or PseudonymUpsertFailedException
                        or ForbiddenException
                        or ArgumentException
            )
        {
            _chainError = ex.Message;
        }
        finally
        {
            _isChaining = false;
        }
    }

    private async Task<ClaimsPrincipal> GetUserAsync() =>
        AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;

    private void SubmitSearch() =>
        StartRun(
            new SearchRun(
                string.IsNullOrWhiteSpace(_searchInput) ? null : _searchInput.Trim(),
                isUserSearch: true
            )
        );

    private void StartRun(SearchRun run)
    {
        // Whatever the previous search is still doing is for something the reader no longer
        // wants.
        _run.Cts?.Cancel();
        _run = run;
        _itemsProvider = request => FetchAsync(run, request);
        _isLoading = true;
    }

    private void CancelSearch()
    {
        if (_run is { IsUserSearch: true, Cts: { } cts } run)
        {
            run.Cancelled = true;
            cts.Cancel();
        }
    }

    private static BlazorBlueprint.Primitives.DataGrid.DataGridResult<PseudonymSearchItemDto> NoItems() =>
        new() { Items = [], TotalItemCount = 0 };

    private async ValueTask<
        BlazorBlueprint.Primitives.DataGrid.DataGridResult<PseudonymSearchItemDto>
    > FetchAsync(SearchRun run, BlazorBlueprint.Primitives.DataGrid.DataGridRequest request)
    {
        // A grid that has been replaced can still ask once more before it is thrown away.
        if (!ReferenceEquals(run, _run))
        {
            return NoItems();
        }

        // Only the first fetch of a search is the search; paging through its results isn't.
        var isSearch = run.IsUserSearch && !run.Started;
        run.Started = true;

        var cancellationToken = request.CancellationToken;
        CancellationTokenSource? searchCts = null;
        if (isSearch)
        {
            // Linked to the grid's own token, so either that or the Cancel button ends the query.
            searchCts = CancellationTokenSource.CreateLinkedTokenSource(request.CancellationToken);
            run.Cts = searchCts;
            cancellationToken = searchCts.Token;
            _isSearching = true;
            StateHasChanged();
        }

        try
        {
            if (run.RestoreShownFirstPage && _shownFirstPage is { } cached && request.StartIndex == 0)
            {
                return cached;
            }

            var user = await GetUserAsync();
            var page = await PseudonymAppService.SearchAsync(
                NamespaceName,
                run.Text,
                request.StartIndex,
                request.Count ?? PageSize,
                user,
                cancellationToken
            );

            var result =
                new BlazorBlueprint.Primitives.DataGrid.DataGridResult<PseudonymSearchItemDto>
                {
                    Items = [.. page.Items],
                    // TotalCount is a long; the grid's pagination footer only accepts int. A
                    // namespace would need over two billion pseudonyms to overflow this.
                    TotalItemCount = (int)page.TotalCount,
                };
            if (ReferenceEquals(run, _run))
            {
                _errorMessage = null;
                _shownSearch = run.Text;
                if (request.StartIndex == 0)
                {
                    _shownFirstPage = result;
                }
            }

            return result;
        }
        catch (OperationCanceledException)
            when (run.Cancelled && !request.CancellationToken.IsCancellationRequested)
        {
            // The Cancel button: this grid is about to be replaced, so what it returns is never
            // shown. The replacement is a grid for the search whose rows were on screen before.
            if (ReferenceEquals(run, _run))
            {
                _searchInput = _shownSearch;
                _isSearching = false;
                StartRun(new SearchRun(_shownSearch, isUserSearch: false) { RestoreShownFirstPage = true });
            }

            return NoItems();
        }
        catch (Exception ex) when (ex is NamespaceNotFoundException or ForbiddenException)
        {
            _errorMessage = ex.Message;
            return NoItems();
        }
        finally
        {
            // BbDataGrid invokes this delegate itself and re-renders on its own afterwards, but
            // that only refreshes the grid's own subtree - it doesn't make its *parent* (this
            // component) re-evaluate the RenderTree that passed IsLoading="_isLoading" as a
            // parameter. Without this call the grid keeps whatever IsLoading value it was handed
            // on the last render this component did, i.e. true forever after the first fetch.
            //
            // Only for the search the grid belongs to: a replaced one has nothing left to say
            // about the loading state, which is its successor's now.
            if (ReferenceEquals(run, _run))
            {
                _isLoading = false;
                if (isSearch)
                {
                    _isSearching = false;
                }
            }

            searchCts?.Dispose();
            if (ReferenceEquals(run.Cts, searchCts))
            {
                run.Cts = null;
            }

            StateHasChanged();
        }
    }

    private async Task CreatePseudonymAsync()
    {
        // Guards against re-entrant invocation - see the identical comment on
        // Namespaces.razor's CreateNamespaceAsync for why this matters under Blazor Server.
        if (_isCreating)
        {
            return;
        }

        _isCreating = true;
        _createError = null;
        _createResults = [];
        try
        {
            var user = await GetUserAsync();
            // The count input only appears (and only means anything) for a multi-psn namespace -
            // force 1 otherwise regardless of stray field state, since CreateAsync would reject
            // anything above that anyway. CreateAsync returns every pseudonym now stored for this
            // original value, not just newly-created ones, so a count that was already satisfied
            // by existing pseudonyms still shows the full set here.
            var count = _allowsMultiplePseudonyms ? Math.Max(1, _createCount) : 1;
            var created = await PseudonymAppService.CreateAsync(
                NamespaceName,
                _createValue,
                count,
                user,
                CancellationToken.None
            );
            _createResults = created;
            _createValue = string.Empty;

            if (_grid is not null)
            {
                await _grid.RefreshDataAsync();
            }
        }
        catch (NamespaceNotFoundException ex)
        {
            _createError = ex.Message;
        }
        catch (ParentPseudonymNotFoundException ex)
        {
            _createError = ex.Message;
        }
        catch (PseudonymUpsertFailedException ex)
        {
            _createError = ex.Message;
        }
        catch (MultiplePseudonymsNotAllowedException ex)
        {
            // Shouldn't happen in practice - namespaces are immutable once created, so
            // _allowsMultiplePseudonyms (fetched once in OnInitializedAsync) can't have gone
            // stale relative to this namespace's actual setting - but the count input is the
            // only thing gating this, so it's still handled rather than left to crash the page.
            _createError = ex.Message;
        }
        catch (ForbiddenException ex)
        {
            _createError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task ReverseLookupAsync()
    {
        // Guards against re-entrant invocation - see the identical comment on
        // Namespaces.razor's CreateNamespaceAsync for why this matters under Blazor Server.
        if (_isLookingUp)
        {
            return;
        }

        _isLookingUp = true;
        _lookupError = null;
        _lookupResult = null;
        try
        {
            var user = await GetUserAsync();
            _lookupResult = await PseudonymAppService.ReverseLookupAsync(
                NamespaceName,
                _lookupValue,
                user,
                CancellationToken.None
            );
            if (_lookupResult is null)
            {
                _lookupError = Localizer[
                    "App.Pseudonyms.NotFoundInNamespace",
                    _lookupValue,
                    NamespaceName
                ];
            }
        }
        catch (ForbiddenException ex)
        {
            _lookupError = ex.Message;
        }
        finally
        {
            _isLookingUp = false;
        }
    }
}
