@page "/not-found"
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.NotFound.Title"]</PageTitle>

@* Reached in two ways that have to look the same: the Router's NotFoundPage for a link inside the
   running app, and the status-code re-execution in Program.cs for an address typed or followed from
   elsewhere - which used to get an empty response, so a blank page with no way back. *@
<div class="bb:mx-auto bb:space-y-6">
    <div class="bb:flex bb:items-center bb:gap-2">
        <LucideIcon aria-hidden="true" Name="search-x" Size="24" Class="bb:shrink-0 bb:text-primary" />
        <h1 class="bb:text-2xl bb:font-semibold bb:tracking-tight">@Localizer["App.NotFound.Title"]</h1>
    </div>
    <BbCard>
        <BbCardContent Class="bb:space-y-4 bb:pt-6">
            <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.NotFound.Description"]</p>
            <BbButton Variant="ButtonVariant.Outline" Href="/ui">@Localizer["App.NotFound.BackHome"]</BbButton>
        </BbCardContent>
    </BbCard>
</div>
