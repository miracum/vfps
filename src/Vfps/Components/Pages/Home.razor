@page "/"
@using Microsoft.Extensions.Options
@using Vfps.Config
@inject IOptions<S3Config> S3ConfigOptions
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>Vfps</PageTitle>

<div class="mx-auto max-w-3xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Vfps</h1>
        <p class="text-muted-foreground">
            @Localizer["App.Home.Subtitle"]
        </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
        <BbCard>
            <BbCardHeader>
                <div class="flex items-center gap-2">
                    <LucideIcon Name="database" Size="18" Class="text-primary" />
                    <BbCardTitle>@Localizer["App.Nav.Namespaces"]</BbCardTitle>
                </div>
                <BbCardDescription>
                    @Localizer["App.Home.NamespacesDescription"]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardFooter>
                <BbButton Href="/ui/namespaces" Variant="ButtonVariant.Outline">
                    @Localizer["App.Common.Open"]
                </BbButton>
            </BbCardFooter>
        </BbCard>

        @if (S3ConfigOptions.Value.IsEnabled)
        {
            <BbCard>
                <BbCardHeader>
                    <div class="flex items-center gap-2">
                        <LucideIcon Name="file-spreadsheet" Size="18" Class="text-primary" />
                        <BbCardTitle>@Localizer["App.Nav.CsvProcessing"]</BbCardTitle>
                    </div>
                    <BbCardDescription>
                        @Localizer["App.Home.CsvProcessingDescription"]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardFooter>
                    <BbButton Href="/ui/csv-jobs" Variant="ButtonVariant.Outline">
                        @Localizer["App.Common.Open"]
                    </BbButton>
                </BbCardFooter>
            </BbCard>
        }
    </div>
</div>
