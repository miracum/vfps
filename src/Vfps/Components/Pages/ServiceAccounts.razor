@page "/service-accounts"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Vfps.Config
@using Vfps.Data.Models
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject IServiceAccountAppService ServiceAccountAppService
@inject IAccessTokenAppService AccessTokenAppService
@inject INamespaceAccessGrantAppService GrantAppService
@inject IStringLocalizer<SharedResources> Localizer
@inject IJSRuntime JS
@inject ILogger<ServiceAccounts> Logger

@*
    Service accounts: named non-human principals with access of their own, and the tokens that
    authenticate as them. Admin-only, because creating one and granting it access is the same
    authority as holding that access - which is exactly why the personal tokens on the Access
    Tokens page, carrying only their owner's own permissions, need no such gate.

    Access itself is granted where all other access is granted: Namespaces -> Configure access,
    picking "Service account" as the grantee. What each account ended up with is summarized here
    so it's visible in one place.
*@

<PageTitle>@Localizer["App.Nav.ServiceAccounts"]</PageTitle>

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex items-center gap-2">
        <LucideIcon Name="bot" Size="24" Class="text-primary" />
        <h1 class="text-2xl font-semibold tracking-tight">@Localizer["App.Nav.ServiceAccounts"]</h1>
    </div>

    @if (!AuthorizationConfigOptions.Value.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessControl.DisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessControl.DisabledDescription"].Value,
                        "<code>Authorization__IsEnabled</code>",
                        "<code>false</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else if (!TokenConfig.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessTokens.FeatureDisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessTokens.FeatureDisabledDescription"].Value,
                        "<code>Authorization__AccessTokens__IsEnabled</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else if (!_isAdmin)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>@Localizer["App.AccessControl.AdminsOnlyTitle"]</BbAlertTitle>
            <BbAlertDescription>@Localizer["App.AccessControl.AdminsOnlyDescription"]</BbAlertDescription>
        </BbAlert>
    }
    else
    {
        @if (_issuedSecret is not null)
        {
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertTitle>@Localizer["App.AccessTokens.IssuedTitle"]</BbAlertTitle>
                <BbAlertDescription>
                    <p class="mb-3">@Localizer["App.AccessTokens.IssuedDescription"]</p>
                    <div class="flex flex-wrap items-center gap-2">
                        <BbInput
                            id="issuedServiceAccountTokenSecret"
                            Value="@_issuedSecret"
                            ReadOnly="true"
                            Class="font-mono w-full sm:w-[34rem]"
                        />
                        <BbButton
                            id="copyIssuedServiceAccountTokenButton"
                            Variant="ButtonVariant.Outline"
                            OnClick="CopySecretAsync"
                        >
                            @(_secretCopied
                                ? Localizer["App.AccessTokens.CopiedAction"]
                                : Localizer["App.AccessTokens.CopyAction"])
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="DismissSecret">
                            @Localizer["App.Common.Close"]
                        </BbButton>
                    </div>
                </BbAlertDescription>
            </BbAlert>
        }

        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertTitle>@Localizer["App.ServiceAccounts.ErrorTitle"]</BbAlertTitle>
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.ServiceAccounts.CreateTitle"]</BbCardTitle>
                <BbCardDescription>@Localizer["App.ServiceAccounts.CreateDescription"]</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <EditForm Model="_newAccount" FormName="create-service-account" OnValidSubmit="CreateAccountAsync">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <BbField>
                            <BbFieldLabel For="newServiceAccountName">
                                @Localizer["App.ServiceAccounts.NameLabel"]
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbInput
                                    @bind-Value="_newAccount.Name"
                                    Id="newServiceAccountName"
                                    Required="true"
                                    Placeholder="etl-pipeline"
                                />
                                <p class="mt-1 text-xs text-muted-foreground">
                                    @Localizer["App.ServiceAccounts.NameHelp"]
                                </p>
                            </BbFieldContent>
                        </BbField>
                        <BbField>
                            <BbFieldLabel For="newServiceAccountDescription">
                                @Localizer["App.ServiceAccounts.DescriptionLabel"]
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbInput
                                    @bind-Value="_newAccount.Description"
                                    Id="newServiceAccountDescription"
                                    Placeholder="@Localizer["App.ServiceAccounts.DescriptionPlaceholder"].Value"
                                />
                            </BbFieldContent>
                        </BbField>
                    </div>
                    <BbButton
                        id="createServiceAccountButton"
                        Type="ButtonType.Submit"
                        Loading="_isCreatingAccount"
                        Class="mt-4"
                        IconPosition="IconPosition.Start"
                    >
                        <Icon>
                            <LucideIcon Name="plus" Size="16" />
                        </Icon>
                        <ChildContent>
                            @Localizer["App.ServiceAccounts.CreateAction"]
                        </ChildContent>
                    </BbButton>
                </EditForm>
            </BbCardContent>
        </BbCard>

        @if (_accounts.Count == 0)
        {
            <p class="text-sm text-muted-foreground">@Localizer["App.ServiceAccounts.NoAccounts"]</p>
        }

        @foreach (var account in _accounts)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>
                        <span class="font-mono">@account.Name</span>
                    </BbCardTitle>
                    <BbCardDescription>
                        @(string.IsNullOrWhiteSpace(account.Description)
                            ? Localizer["App.ServiceAccounts.NoDescription"].Value
                            : account.Description)
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm font-medium">@Localizer["App.ServiceAccounts.GrantsTitle"]</p>
                            @{
                                var grants = GrantsFor(account.Name);
                            }
                            @if (grants.Count == 0)
                            {
                                <p class="mt-1 text-xs text-muted-foreground">
                                    @Localizer["App.ServiceAccounts.NoGrants"]
                                </p>
                            }
                            else
                            {
                                <div class="mt-1 flex flex-wrap gap-2">
                                    @foreach (var grant in grants)
                                    {
                                        <BbBadge Variant="BadgeVariant.Outline">
                                            @(grant.NamespaceName ?? Localizer["App.AccessControl.AllNamespaces"].Value):
                                            @PermissionSummary(grant)
                                        </BbBadge>
                                    }
                                </div>
                            }
                        </div>

                        <div>
                            <p class="text-sm font-medium">@Localizer["App.ServiceAccounts.TokensTitle"]</p>
                            @{
                                var tokens = TokensFor(account.Name);
                            }
                            @if (tokens.Count == 0)
                            {
                                <p class="mt-1 text-xs text-muted-foreground">
                                    @Localizer["App.AccessTokens.NoTokens"]
                                </p>
                            }
                            else
                            {
                                <div class="mt-2 space-y-2">
                                    @foreach (var token in tokens)
                                    {
                                        var status = Status(token);
                                        <div class="rounded-md border border-border p-3">
                                            <div class="flex flex-wrap items-center justify-between gap-2">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <BbBadge Variant="@status.Variant">@status.Label</BbBadge>
                                                    <span class="text-sm font-medium">@token.Name</span>
                                                    <code class="text-xs text-muted-foreground">@token.TokenId</code>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    @if (token.RevokedAt is null)
                                                    {
                                                        <BbButton
                                                            id="@($"revokeServiceAccountToken-{token.Id}")"
                                                            Variant="ButtonVariant.Outline"
                                                            Size="ButtonSize.Small"
                                                            OnClick="@(() => RevokeTokenAsync(token))"
                                                        >
                                                            @Localizer["App.AccessTokens.RevokeAction"]
                                                        </BbButton>
                                                    }
                                                    <BbButton
                                                        id="@($"deleteServiceAccountToken-{token.Id}")"
                                                        Variant="ButtonVariant.Destructive"
                                                        Size="ButtonSize.Small"
                                                        OnClick="@(() => DeleteTokenAsync(token))"
                                                    >
                                                        @Localizer["App.Common.Delete"]
                                                    </BbButton>
                                                </div>
                                            </div>
                                            <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted-foreground">
                                                <span>@Localizer["App.AccessTokens.ColumnExpires"]: @Format(token.ExpiresAt)</span>
                                                <span>@Localizer["App.AccessTokens.ColumnLastUsed"]: @Format(token.LastUsedAt)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mt-3 flex flex-wrap items-end gap-2">
                                <BbField Class="w-64">
                                    <BbFieldLabel For="@($"issueTokenName-{account.Name}")">
                                        @Localizer["App.AccessTokens.NameLabel"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <BbInput
                                            Value="@TokenDraftFor(account.Name).Name"
                                            ValueChanged="@((string value) => TokenDraftFor(account.Name).Name = value)"
                                            ValueExpression="@(() => TokenDraftFor(account.Name).Name)"
                                            Id="@($"issueTokenName-{account.Name}")"
                                            Placeholder="@Localizer["App.AccessTokens.NamePlaceholder"].Value"
                                        />
                                    </BbFieldContent>
                                </BbField>
                                <BbField Class="w-40">
                                    <BbFieldLabel For="@($"issueTokenLifetime-{account.Name}")">
                                        @Localizer["App.AccessTokens.LifetimeLabel"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <BbNumericInput
                                            Value="@TokenDraftFor(account.Name).LifetimeDays"
                                            ValueChanged="@((int value) => TokenDraftFor(account.Name).LifetimeDays = value)"
                                            ValueExpression="@(() => TokenDraftFor(account.Name).LifetimeDays)"
                                            Id="@($"issueTokenLifetime-{account.Name}")"
                                            Min="1"
                                            Max="@MaximumLifetimeDays"
                                        />
                                    </BbFieldContent>
                                </BbField>
                                <BbButton
                                    id="@($"issueToken-{account.Name}")"
                                    Loading="@(_issuingFor == account.Name)"
                                    OnClick="@(() => IssueTokenAsync(account))"
                                >
                                    @Localizer["App.ServiceAccounts.IssueTokenAction"]
                                </BbButton>
                            </div>
                        </div>
                    </div>
                </BbCardContent>
                <BbCardFooter>
                    @if (_pendingDelete == account.Name)
                    {
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-sm">
                                @string.Format(
                                    Localizer["App.ServiceAccounts.DeleteConfirm"].Value,
                                    account.Name
                                )
                            </span>
                            <BbButton
                                id="@($"confirmDeleteServiceAccount-{account.Name}")"
                                Variant="ButtonVariant.Destructive"
                                Size="ButtonSize.Small"
                                Loading="_isDeleting"
                                OnClick="@(() => ConfirmDeleteAccountAsync(account))"
                            >
                                @Localizer["App.Common.Delete"]
                            </BbButton>
                            <BbButton
                                Variant="ButtonVariant.Outline"
                                Size="ButtonSize.Small"
                                OnClick="@(() => _pendingDelete = null)"
                            >
                                @Localizer["App.Common.Cancel"]
                            </BbButton>
                        </div>
                    }
                    else
                    {
                        <BbButton
                            id="@($"deleteServiceAccount-{account.Name}")"
                            Variant="ButtonVariant.Destructive"
                            Size="ButtonSize.Small"
                            OnClick="@(() => _pendingDelete = account.Name)"
                        >
                            @Localizer["App.ServiceAccounts.DeleteAction"]
                        </BbButton>
                    }
                </BbCardFooter>
            </BbCard>
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal _user = new();
    private bool _isAdmin;
    private IReadOnlyList<ServiceAccount> _accounts = [];
    private IReadOnlyList<AccessToken> _tokens = [];
    private IReadOnlyList<NamespaceAccessGrant> _grants = [];
    private readonly NewAccountModel _newAccount = new();
    private readonly Dictionary<string, TokenDraft> _tokenDrafts = new(StringComparer.Ordinal);
    private bool _isCreatingAccount;
    private bool _isDeleting;
    private string? _issuingFor;
    private string? _pendingDelete;
    private string? _error;
    private string? _issuedSecret;
    private bool _secretCopied;
    private TimeZoneInfo _browserTimeZone = TimeZoneInfo.Utc;

    private AccessTokenConfig TokenConfig => AuthorizationConfigOptions.Value.AccessTokens;

    private int MaximumLifetimeDays =>
        TokenConfig.MaximumLifetime > TimeSpan.Zero
            ? (int)Math.Ceiling(TokenConfig.MaximumLifetime.TotalDays)
            : int.MaxValue;

    private bool IsUsable =>
        AuthorizationConfigOptions.Value.IsEnabled && TokenConfig.IsEnabled && _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _user =
            AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        _isAdmin = PermissionChecker.IsAdmin(_user);

        if (IsUsable)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsUsable)
        {
            await ResolveBrowserTimeZoneAsync();
        }
    }

    private async Task LoadAsync()
    {
        _accounts = await ServiceAccountAppService.GetAllAsync(_user, CancellationToken.None);
        _tokens = await AccessTokenAppService.GetAllAsync(_user, CancellationToken.None);
        _grants = await GrantAppService.GetAllAsync(_user, CancellationToken.None);
    }

    private TokenDraft TokenDraftFor(string accountName)
    {
        if (!_tokenDrafts.TryGetValue(accountName, out var draft))
        {
            draft = new TokenDraft
            {
                LifetimeDays = Math.Max(1, (int)Math.Round(TokenConfig.DefaultLifetime.TotalDays)),
            };
            _tokenDrafts[accountName] = draft;
        }

        return draft;
    }

    private List<NamespaceAccessGrant> GrantsFor(string accountName) =>
        [
            .. _grants
                .Where(g =>
                    g.GranteeType == GranteeType.ServiceAccount
                    && string.Equals(g.Grantee, accountName, StringComparison.Ordinal)
                )
                .OrderBy(g => g.NamespaceName, StringComparer.Ordinal),
        ];

    private List<AccessToken> TokensFor(string accountName) =>
        [
            .. _tokens
                .Where(t =>
                    t.TokenType == AccessTokenType.ServiceAccount
                    && string.Equals(t.ServiceAccountName, accountName, StringComparison.Ordinal)
                )
                .OrderByDescending(t => t.CreatedAt),
        ];

    private async Task CreateAccountAsync()
    {
        _isCreatingAccount = true;
        _error = null;

        try
        {
            await ServiceAccountAppService.CreateAsync(
                _newAccount.Name,
                _newAccount.Description,
                _user,
                CancellationToken.None
            );

            _newAccount.Reset();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isCreatingAccount = false;
        }
    }

    private async Task ConfirmDeleteAccountAsync(ServiceAccount account)
    {
        _isDeleting = true;
        _error = null;

        try
        {
            await ServiceAccountAppService.DeleteAsync(
                account.Name,
                _user,
                CancellationToken.None
            );
            _tokenDrafts.Remove(account.Name);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isDeleting = false;
            _pendingDelete = null;
        }

        await LoadAsync();
    }

    private async Task IssueTokenAsync(ServiceAccount account)
    {
        _issuingFor = account.Name;
        _error = null;
        _issuedSecret = null;
        _secretCopied = false;

        var draft = TokenDraftFor(account.Name);

        try
        {
            var issued = await AccessTokenAppService.CreateForServiceAccountAsync(
                account.Name,
                draft.Name,
                TimeSpan.FromDays(draft.LifetimeDays),
                _user,
                CancellationToken.None
            );

            _issuedSecret = issued.Secret;
            draft.Name = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _issuingFor = null;
        }
    }

    private async Task RevokeTokenAsync(AccessToken token)
    {
        _error = null;

        try
        {
            await AccessTokenAppService.RevokeAsync(token.Id, _user, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadAsync();
    }

    private async Task DeleteTokenAsync(AccessToken token)
    {
        _error = null;

        try
        {
            await AccessTokenAppService.DeleteAsync(token.Id, _user, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadAsync();
    }

    private async Task CopySecretAsync()
    {
        if (_issuedSecret is null)
        {
            return;
        }

        try
        {
            _secretCopied = await JS.InvokeAsync<bool>("vfpsClipboard.copy", _issuedSecret);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            Logger.LogWarning(ex, "Failed to copy the issued access token to the clipboard");
            _secretCopied = false;
        }
    }

    private void DismissSecret()
    {
        _issuedSecret = null;
        _secretCopied = false;
    }

    private async Task ResolveBrowserTimeZoneAsync()
    {
        try
        {
            var ianaId = await JS.InvokeAsync<string>("vfpsTimeZone.get");
            _browserTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ianaId);
        }
        catch (Exception ex)
            when (ex is Microsoft.JSInterop.JSException or TimeZoneNotFoundException)
        {
            Logger.LogWarning(ex, "Failed to resolve the browser's time zone, defaulting to UTC");
            return;
        }

        StateHasChanged();
    }

    private string Format(DateTimeOffset? timestamp) =>
        timestamp is null
            ? Localizer["App.AccessTokens.Never"].Value
            : TimeZoneInfo.ConvertTime(timestamp.Value, _browserTimeZone).ToString("g");

    private (string Label, BadgeVariant Variant) Status(AccessToken token)
    {
        if (token.RevokedAt is not null)
        {
            return (Localizer["App.AccessTokens.StatusRevoked"].Value, BadgeVariant.Destructive);
        }

        return token.ExpiresAt <= DateTimeOffset.UtcNow
            ? (Localizer["App.AccessTokens.StatusExpired"].Value, BadgeVariant.Secondary)
            : (Localizer["App.AccessTokens.StatusActive"].Value, BadgeVariant.Default);
    }

    private string PermissionSummary(NamespaceAccessGrant grant)
    {
        List<string> permissions = [];

        if (grant.CanRead)
        {
            permissions.Add(Localizer["App.AccessControl.Read"].Value);
        }

        if (grant.CanWrite)
        {
            permissions.Add(Localizer["App.AccessControl.Write"].Value);
        }

        if (grant.CanReverseLookup)
        {
            permissions.Add(Localizer["App.AccessControl.ReverseLookup"].Value);
        }

        return string.Join(", ", permissions);
    }

    private sealed class NewAccountModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;

        public void Reset()
        {
            Name = string.Empty;
            Description = string.Empty;
        }
    }

    private sealed class TokenDraft
    {
        public string Name { get; set; } = string.Empty;
        public int LifetimeDays { get; set; } = 90;
    }
}
