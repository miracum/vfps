@page "/access-tokens"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Vfps.Config
@using Vfps.Data.Models
@inject IOptions<AuthorizationConfig> AuthorizationConfigOptions
@inject INamespacePermissionChecker PermissionChecker
@inject IAccessTokenAppService AccessTokenAppService
@inject IStringLocalizer<SharedResources> Localizer
@inject IJSRuntime JS
@inject ILogger<AccessTokens> Logger

@*
    Self-service personal access tokens: any signed-in user can mint a credential that carries
    their own access, for a client that can't get a token from the identity provider. Service
    accounts - the admin-managed kind, with access of their own - live on their own page.
*@

<PageTitle>@Localizer["App.Nav.AccessTokens"]</PageTitle>

<div class="bb:mx-auto bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
        <div class="bb:flex bb:items-center bb:gap-2">
            <LucideIcon Name="key-round" Size="24" Class="bb:text-primary" />
            <h1 class="bb:text-2xl bb:font-semibold bb:tracking-tight">@Localizer["App.Nav.AccessTokens"]</h1>
        </div>
        @if (IsUsable)
        {
            <BbButton
                id="showCreateAccessTokenButton"
                IconPosition="IconPosition.Start"
                OnClick="() => OnCreateDialogOpenChanged(true)"
            >
                <Icon>
                    <LucideIcon Name="plus" Size="16" />
                </Icon>
                <ChildContent>
                    @Localizer["App.AccessTokens.CreateAction"]
                </ChildContent>
            </BbButton>
        }
    </div>

    @if (!AuthorizationConfigOptions.Value.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessControl.DisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessControl.DisabledDescription"].Value,
                        "<code>Authorization__IsEnabled</code>",
                        "<code>false</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else if (!TokenConfig.IsEnabled)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>@Localizer["App.AccessTokens.FeatureDisabledTitle"]</BbAlertTitle>
            <BbAlertDescription>
                @((MarkupString)
                    string.Format(
                        Localizer["App.AccessTokens.FeatureDisabledDescription"].Value,
                        "<code>Authorization__AccessTokens__IsEnabled</code>"
                    ))
            </BbAlertDescription>
        </BbAlert>
    }
    else
    {
        @* Two columns once there's room - the tokens themselves, and beside them how to use one -
           stacked below lg. Only from utilities the shipped stylesheet carries (see app.css's note
           on why that matters), which is why the side card caps its width from md rather than lg:
           there is no lg:max-w-* in the bundle, so on a tablet the stacked card stays 420px wide. *@
        <div class="bb:space-y-6 bb:lg:flex bb:lg:gap-8">
            <div class="bb:min-w-0 bb:flex-1 bb:space-y-6">
                @if (_issuedSecret is not null)
                {
                    @* Shown once and never again: only the hash is stored, so navigating away without
                       copying this means creating a new token. *@
                    <BbAlert Variant="AlertVariant.Warning">
                        <BbAlertTitle>@Localizer["App.AccessTokens.IssuedTitle"]</BbAlertTitle>
                        <BbAlertDescription>
                            <p class="bb:mb-3">@Localizer["App.AccessTokens.IssuedDescription"]</p>
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <BbInput
                                    id="issuedTokenSecret"
                                    Value="@_issuedSecret"
                                    ReadOnly="true"
                                    Class="bb:font-mono bb:w-full"
                                />
                                <BbButton id="copyIssuedTokenButton" Variant="ButtonVariant.Outline" OnClick="CopySecretAsync">
                                    @(_secretCopied
                                        ? Localizer["App.AccessTokens.CopiedAction"]
                                        : Localizer["App.AccessTokens.CopyAction"])
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" OnClick="DismissSecret">
                                    @Localizer["App.Common.Close"]
                                </BbButton>
                            </div>
                            <p class="bb:mt-3 bb:text-xs">
                                @((MarkupString)
                                    string.Format(
                                        Localizer["App.AccessTokens.UsageHint"].Value,
                                        "<code>Authorization: Bearer &lt;token&gt;</code>"
                                    ))
                            </p>
                        </BbAlertDescription>
                    </BbAlert>
                }


                @* The form is a dialog opened from the header, so the tokens themselves are what the
                   page opens on. The secret it produces is deliberately not shown in the dialog:
                   one stray click outside it would close it and lose the token for good. It goes
                   to the alert above instead, which only its own Close button dismisses. *@
                <BbDialog Open="_showCreateDialog" OpenChanged="OnCreateDialogOpenChanged">
                    <BbDialogContent>
                        <BbDialogHeader>
                            <BbDialogTitle Class="bb:leading-tight">@Localizer["App.AccessTokens.CreateTitle"]</BbDialogTitle>
                            <BbDialogDescription>@Localizer["App.AccessTokens.CreateDescription"]</BbDialogDescription>
                        </BbDialogHeader>
                        @if (_createError is not null)
                        {
                            <BbAlert Variant="AlertVariant.Danger">
                                <BbAlertTitle>@Localizer["App.AccessTokens.ErrorTitle"]</BbAlertTitle>
                                <BbAlertDescription>@_createError</BbAlertDescription>
                            </BbAlert>
                        }
                        <EditForm Model="_newToken" FormName="create-access-token" OnValidSubmit="CreateAsync">
                            <div class="bb:space-y-4 bb:py-2">
                                <BbField>
                                    <BbFieldLabel For="newTokenName">@Localizer["App.AccessTokens.NameLabel"]</BbFieldLabel>
                                    <BbFieldContent>
                                        <BbInput
                                            @bind-Value="_newToken.Name"
                                            Id="newTokenName"
                                            Required="true"
                                            Placeholder="@Localizer["App.AccessTokens.NamePlaceholder"].Value"
                                        />
                                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                            @Localizer["App.AccessTokens.NameHelp"]
                                        </p>
                                    </BbFieldContent>
                                </BbField>
                                <BbField>
                                    <BbFieldLabel For="newTokenLifetime">
                                        @Localizer["App.AccessTokens.LifetimeLabel"]
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <BbNumericInput
                                            @bind-Value="_newToken.LifetimeDays"
                                            Id="newTokenLifetime"
                                            Min="1"
                                            Max="@MaximumLifetimeDays"
                                        />
                                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                            @LifetimeHelp
                                        </p>
                                    </BbFieldContent>
                                </BbField>
                            </div>
                            <BbDialogFooter>
                                <BbButton Variant="ButtonVariant.Outline" OnClick="() => OnCreateDialogOpenChanged(false)">
                                    @Localizer["App.Common.Cancel"]
                                </BbButton>
                                <BbButton
                                    id="createAccessTokenButton"
                                    Type="ButtonType.Submit"
                                    Loading="_isCreating"
                                >
                                    @Localizer["App.AccessTokens.CreateAction"]
                                </BbButton>
                            </BbDialogFooter>
                        </EditForm>
                    </BbDialogContent>
                </BbDialog>

                <BbCard>
                    <BbCardHeader>
                        <SectionTitle>@Localizer["App.AccessTokens.MineTitle"]</SectionTitle>
                        <BbCardDescription>@Localizer["App.AccessTokens.MineDescription"]</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        @TokenTable(_myTokens, showOwner: false)
                    </BbCardContent>
                </BbCard>

                @if (_isAdmin)
                {
                    <BbCard>
                        <BbCardHeader>
                            <SectionTitle>@Localizer["App.AccessTokens.AllTitle"]</SectionTitle>
                            <BbCardDescription>@Localizer["App.AccessTokens.AllDescription"]</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @TokenTable(_allTokens, showOwner: true)
                        </BbCardContent>
                    </BbCard>
                }
            </div>
            <aside class="bb:w-full bb:self-start bb:sticky bb:top-6 bb:md:max-w-[420px]">
                <AccessTokenUsageExamples />
            </aside>
        </div>

        @* Revoking and deleting both cut off whatever still uses the token, and neither can be
           taken back - so each one names the token and when it was last used before it goes. *@
        <ConfirmDialog
            Open="@(_pendingTokenAction is not null)"
            Title="@PendingTokenActionTitle"
            ConfirmLabel="@(_pendingTokenAction?.IsRevoke == true ? Localizer["App.AccessTokens.RevokeAction"].Value : Localizer["App.Common.Delete"].Value)"
            ConfirmButtonId="confirmTokenActionButton"
            IsBusy="_isConfirmingTokenAction"
            Error="@_tokenActionError"
            OnConfirm="ConfirmTokenActionAsync"
            OnCancel="CancelTokenAction"
        >
            @if (_pendingTokenAction is { } pending)
            {
                @string.Format(
                    pending.IsRevoke
                        ? Localizer["App.AccessTokens.RevokeConfirmBody"].Value
                        : Localizer["App.AccessTokens.DeleteConfirmBody"].Value,
                    Format(pending.Token.LastUsedAt)
                )
            }
        </ConfirmDialog>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal _user = new();
    private bool _isAdmin;
    private IReadOnlyList<AccessToken> _myTokens = [];
    private IReadOnlyList<AccessToken> _allTokens = [];
    private readonly NewTokenModel _newToken = new();
    private bool _isCreating;
    private bool _showCreateDialog;

    // A failed create is reported in the create dialog, a failed revoke or delete in its
    // confirmation dialog - each next to the button that was clicked.
    private string? _createError;
    private string? _issuedSecret;
    private bool _secretCopied;
    private TimeZoneInfo _browserTimeZone = TimeZoneInfo.Utc;

    private AccessTokenConfig TokenConfig => AuthorizationConfigOptions.Value.AccessTokens;

    private int MaximumLifetimeDays =>
        TokenConfig.MaximumLifetime > TimeSpan.Zero
            ? (int)Math.Ceiling(TokenConfig.MaximumLifetime.TotalDays)
            : int.MaxValue;

    private string LifetimeHelp =>
        TokenConfig.MaximumLifetime > TimeSpan.Zero
            ? string.Format(
                Localizer["App.AccessTokens.LifetimeHelp"].Value,
                MaximumLifetimeDays
            )
            : Localizer["App.AccessTokens.LifetimeHelpUncapped"].Value;

    protected override async Task OnInitializedAsync()
    {
        _user =
            AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        _isAdmin = PermissionChecker.IsAdmin(_user);
        _newToken.LifetimeDays = Math.Max(1, (int)Math.Round(TokenConfig.DefaultLifetime.TotalDays));

        if (IsUsable)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsUsable)
        {
            await ResolveBrowserTimeZoneAsync();
        }
    }

    private bool IsUsable => AuthorizationConfigOptions.Value.IsEnabled && TokenConfig.IsEnabled;

    private async Task LoadAsync()
    {
        _myTokens = await AccessTokenAppService.GetMineAsync(_user, CancellationToken.None);

        if (_isAdmin)
        {
            _allTokens = await AccessTokenAppService.GetAllAsync(_user, CancellationToken.None);
        }
    }

    // Also reached when the dialog closes itself - the overlay, Escape, or its own close button.
    private void OnCreateDialogOpenChanged(bool open)
    {
        _showCreateDialog = open;
        if (!open)
        {
            _createError = null;
        }
    }

    private async Task CreateAsync()
    {
        _isCreating = true;
        _createError = null;
        _issuedSecret = null;
        _secretCopied = false;

        try
        {
            var issued = await AccessTokenAppService.CreatePersonalAsync(
                _newToken.Name,
                TimeSpan.FromDays(_newToken.LifetimeDays),
                _user,
                CancellationToken.None
            );

            _issuedSecret = issued.Secret;
            _newToken.Reset();
            OnCreateDialogOpenChanged(false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    // The token a Revoke or Delete button was clicked for, waiting on its confirmation.
    private sealed record PendingTokenAction(AccessToken Token, bool IsRevoke);

    private PendingTokenAction? _pendingTokenAction;
    private bool _isConfirmingTokenAction;
    private string? _tokenActionError;

    private string PendingTokenActionTitle =>
        _pendingTokenAction is not { } pending
            ? string.Empty
            : string.Format(
                pending.IsRevoke
                    ? Localizer["App.AccessTokens.RevokeConfirmTitle"].Value
                    : Localizer["App.AccessTokens.DeleteConfirmTitle"].Value,
                pending.Token.Name
            );

    private void StartTokenAction(AccessToken token, bool isRevoke)
    {
        _pendingTokenAction = new PendingTokenAction(token, isRevoke);
        _tokenActionError = null;
    }

    private void CancelTokenAction()
    {
        _pendingTokenAction = null;
        _tokenActionError = null;
    }

    private async Task ConfirmTokenActionAsync()
    {
        // Same re-entrancy guard as CreateNamespaceAsync: a second click can race ahead of the
        // render that disables the button.
        if (_isConfirmingTokenAction || _pendingTokenAction is not { } pending)
        {
            return;
        }

        _isConfirmingTokenAction = true;
        _tokenActionError = null;

        try
        {
            if (pending.IsRevoke)
            {
                await AccessTokenAppService.RevokeAsync(pending.Token.Id, _user, CancellationToken.None);
            }
            else
            {
                await AccessTokenAppService.DeleteAsync(pending.Token.Id, _user, CancellationToken.None);
            }

            _pendingTokenAction = null;
        }
        catch (Exception ex)
        {
            // Left open with the reason, so the action can be retried or abandoned.
            _tokenActionError = ex.Message;
        }
        finally
        {
            _isConfirmingTokenAction = false;
        }

        // Reloaded either way: on success to show the change, on failure because the likeliest
        // cause is someone else having already revoked or deleted it.
        await LoadAsync();
    }

    private async Task CopySecretAsync()
    {
        if (_issuedSecret is null)
        {
            return;
        }

        try
        {
            _secretCopied = await JS.InvokeAsync<bool>("vfpsClipboard.copy", _issuedSecret);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            // The value is on screen either way - a failed copy is a convenience lost, not an
            // error worth interrupting the one chance to read the token.
            Logger.LogWarning(ex, "Failed to copy the issued access token to the clipboard");
            _secretCopied = false;
        }
    }

    private void DismissSecret()
    {
        _issuedSecret = null;
        _secretCopied = false;
    }

    private async Task ResolveBrowserTimeZoneAsync()
    {
        try
        {
            var ianaId = await JS.InvokeAsync<string>("vfpsTimeZone.get");
            _browserTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ianaId);
        }
        catch (Exception ex)
            when (ex is Microsoft.JSInterop.JSException or TimeZoneNotFoundException)
        {
            Logger.LogWarning(ex, "Failed to resolve the browser's time zone, defaulting to UTC");
            return;
        }

        StateHasChanged();
    }

    private string Format(DateTimeOffset? timestamp) =>
        timestamp is null
            ? Localizer["App.AccessTokens.Never"].Value
            : TimeZoneInfo.ConvertTime(timestamp.Value, _browserTimeZone).ToString("g");

    private string Owner(AccessToken token) =>
        token.TokenType == AccessTokenType.ServiceAccount
            ? token.ServiceAccountName ?? string.Empty
            : token.Username ?? token.Subject ?? string.Empty;

    private RenderFragment TokenTable(IReadOnlyList<AccessToken> tokens, bool showOwner) =>
        @<div>
            @if (tokens.Count == 0)
            {
                <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.AccessTokens.NoTokens"]</p>
            }
            else
            {
                <div class="bb:space-y-2">
                    @foreach (var token in tokens)
                    {
                        <div class="bb:rounded-md bb:border bb:border-border bb:p-3">
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                    <AccessTokenStatusBadge Token="token" />
                                    <span class="break-anywhere bb:text-sm bb:font-medium">@token.Name</span>
                                    @if (showOwner)
                                    {
                                        <BbBadge Variant="BadgeVariant.Outline">
                                            @(token.TokenType == AccessTokenType.ServiceAccount
                                                ? Localizer["App.AccessTokens.TypeServiceAccount"]
                                                : Localizer["App.AccessTokens.TypePersonal"])
                                        </BbBadge>
                                        <span class="bb:text-sm bb:text-muted-foreground">@Owner(token)</span>
                                    }
                                    <code class="bb:text-xs bb:text-muted-foreground">@token.TokenId</code>
                                </div>
                                <div class="bb:flex bb:items-center bb:gap-2">
                                    @if (token.RevokedAt is null)
                                    {
                                        <BbButton
                                            id="@($"revokeToken-{token.Id}")"
                                            Variant="ButtonVariant.Outline"
                                            Size="ButtonSize.Small"
                                            OnClick="@(() => StartTokenAction(token, isRevoke: true))"
                                        >
                                            @Localizer["App.AccessTokens.RevokeAction"]
                                        </BbButton>
                                    }
                                    <BbButton
                                        id="@($"deleteToken-{token.Id}")"
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Small"
                                        Class="destructive-action"
                                        OnClick="@(() => StartTokenAction(token, isRevoke: false))"
                                    >
                                        @Localizer["App.Common.Delete"]
                                    </BbButton>
                                </div>
                            </div>
                            <div class="token-meta bb:mt-2 bb:flex bb:flex-wrap bb:text-xs bb:text-muted-foreground">
                                <span>@Localizer["App.AccessTokens.ColumnCreated"]: @Format(token.CreatedAt)</span>
                                <span>@Localizer["App.AccessTokens.ColumnExpires"]: @Format(token.ExpiresAt)</span>
                                <span>@Localizer["App.AccessTokens.ColumnLastUsed"]: @Format(token.LastUsedAt)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>;

    private sealed class NewTokenModel
    {
        public string Name { get; set; } = string.Empty;
        public int LifetimeDays { get; set; } = 90;

        /// <summary>
        /// Clears the label only - the lifetime is left as it was, since someone creating a
        /// second token usually wants it to live as long as the first.
        /// </summary>
        public void Reset() => Name = string.Empty;
    }
}
