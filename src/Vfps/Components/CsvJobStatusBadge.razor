@using Vfps.Data.Models
@inject IStringLocalizer<SharedResources> Localizer

@*
    A CSV job's status as a single badge. Shared by the CSV Jobs page's grid and the home page's
    recent-jobs list, which show the same jobs and must never disagree about what a status means.
*@

<BbBadge Variant="@VariantFor(Status)" Class="@ClassFor(Status)">
    @LabelFor(Status)
</BbBadge>

@code {
    [Parameter, EditorRequired]
    public required PseudonymizationJobStatus Status { get; set; }

    private string LabelFor(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.AwaitingUpload => Localizer["App.CsvJobs.StatusAwaitingUpload"],
            PseudonymizationJobStatus.Queued => Localizer["App.CsvJobs.StatusQueued"],
            PseudonymizationJobStatus.Running => Localizer["App.CsvJobs.StatusRunning"],
            PseudonymizationJobStatus.Completed => Localizer["App.CsvJobs.StatusCompleted"],
            PseudonymizationJobStatus.Failed => Localizer["App.CsvJobs.StatusFailed"],
            PseudonymizationJobStatus.Cancelled => Localizer["App.CsvJobs.StatusCancelled"],
            PseudonymizationJobStatus.Stalled => Localizer["App.CsvJobs.StatusStalled"],
            _ => status.ToString(),
        };

    private static BadgeVariant VariantFor(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.Failed => BadgeVariant.Destructive,
            // Outline, not Destructive - Stalled is only ever a heuristic guess (see the enum's
            // own doc comment), so the badge shouldn't read as confidently as a confirmed Failed.
            PseudonymizationJobStatus.Stalled => BadgeVariant.Outline,
            PseudonymizationJobStatus.Cancelled => BadgeVariant.Outline,
            PseudonymizationJobStatus.Completed => BadgeVariant.Default,
            _ => BadgeVariant.Secondary,
        };

    // Plain, global CSS classes (wwwroot/app.css), not Tailwind utilities - see that file's own
    // comment for why arbitrary Tailwind classes (and Blazor CSS isolation) don't work here.
    private static string? ClassFor(PseudonymizationJobStatus status) =>
        status switch
        {
            PseudonymizationJobStatus.Completed => "badge-completed",
            PseudonymizationJobStatus.Stalled => "badge-warning-amber",
            _ => null,
        };
}
