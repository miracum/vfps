@using Vfps.Data.Models

@*
    One node of the namespace hierarchy, rendering its own descendants by recursing into itself.

    This is BbTreeView's declarative mode: the node itself is a BbTreeItem, so expand/collapse,
    selection, roving-tabindex keyboard navigation and the ARIA tree wiring all come from the
    component library.

    The data is the flat namespace list the page already loaded: a namespace carries its
    ParentName, and namespace cardinality is low by design (see INamespaceRepository.GetAllAsync),
    so the whole tree is grouped in memory rather than costing a request per level.
*@

<BbTreeItem Value="@Node.Name" Icon="@Icon" IsLeaf="@(Children.Count == 0)">
    <LabelTemplate>
        <span data-namespace-label class="bb:truncate">@Node.Name</span>
    </LabelTemplate>
    <ChildContent>
        @foreach (var child in Children)
        {
            <NamespaceTreeNode
                Node="child"
                ChildrenByParent="ChildrenByParent"
                VisibleNames="VisibleNames"
                Depth="Depth + 1"
                Ancestry="NodeAncestry"
            />
        }
    </ChildContent>
</BbTreeItem>

@code {
    [Parameter, EditorRequired]
    public Namespace Node { get; set; } = null!;

    /// <summary>Every namespace grouped by its parent's name - the whole tree, precomputed once.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, List<Namespace>> ChildrenByParent { get; set; } = null!;

    /// <summary>
    /// The namespaces the page's tree search leaves on screen, or null when no search is active.
    /// Filtering happens here rather than in BbTreeView because the component only filters in its
    /// data-driven mode - see VisibleNamespaceNames on the namespaces page.
    /// </summary>
    [Parameter]
    public IReadOnlySet<string>? VisibleNames { get; set; }

    [Parameter]
    public int Depth { get; set; }

    /// <summary>
    /// The names on the path from the root down to (and including) this node's parent. Purely a
    /// cycle guard: a parent link is immutable and can only ever point at an already-existing
    /// namespace, so a cycle can't be created through the API - but a hand-edited database
    /// shouldn't be able to hang the render loop.
    /// </summary>
    [Parameter]
    public IReadOnlySet<string> Ancestry { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    private string Icon => Depth == 0 ? "database" : "corner-down-right";

    private HashSet<string> NodeAncestry =>
        new(Ancestry, StringComparer.Ordinal) { Node.Name };

    private List<Namespace> Children =>
        ChildrenByParent.TryGetValue(Node.Name, out var children)
            ?
            [
                .. children.Where(c =>
                    !Ancestry.Contains(c.Name)
                    && c.Name != Node.Name
                    && (VisibleNames is null || VisibleNames.Contains(c.Name))
                ),
            ]
            : [];
}
