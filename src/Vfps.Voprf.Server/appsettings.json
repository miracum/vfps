{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Protocols": "Http2",
        "Url": "https://0.0.0.0:8081"
      }
    }
  },
  "VoprfServer": {
    "Key": {
      "Source": "Seed",
      "FilePath": "",
      "Base64": "",
      "KeyId": "v1"
    },
    "MaxBatchSize": 128,
    "Hardening": {
      "IsEnabled": true,
      "RequireTls": true,
      "RequireAuthentication": true,
      "EnableReflection": false,
      "EnableDetailedErrors": false,
      "MaxReceiveMessageSizeBytes": 65536,
      "RateLimit": {
        "IsEnabled": true,
        "PermitsPerWindow": 600,
        "Window": "0.00:01:00",
        "QueueLimit": 0
      }
    },
    "Authentication": {
      "Mode": "ClientCertificate",
      "ClientCertificate": {
        "AllowedThumbprints": [],
        "CheckRevocation": false
      },
      "Jwt": {
        "Authority": "",
        "Audience": "",
        "RequiredScope": ""
      }
    }
  }
}
