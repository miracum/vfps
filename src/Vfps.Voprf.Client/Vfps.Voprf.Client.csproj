<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Vfps.Voprf.Client</RootNamespace>
    <!-- Vfps publishes RID-specific and references this; without the RID its
      locked-mode restore fails on this project's lock file -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vfps.Voprf.Contracts\Vfps.Voprf.Contracts.csproj" />
    <ProjectReference Include="..\Vfps.Voprf\Vfps.Voprf.csproj" />
  </ItemGroup>
</Project>
